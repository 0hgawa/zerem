msgid "A .torrent file dropped in a watched folder is added on its own."
msgstr "Tệp .torrent thả vào thư mục đang theo dõi sẽ tự được thêm vào."

msgid "A BitTorrent client that does not get in the way."
msgstr "Một ứng dụng BitTorrent không làm vướng chân bạn."

msgid "A magnet has none until its metadata arrives."
msgstr "Một magnet chưa có gì cho tới khi siêu dữ liệu của nó về."

msgid "A magnet link carries no file list — it has to be asked for."
msgstr "Liên kết magnet không mang theo danh sách tệp — phải đi hỏi mới có."

msgid "A paused torrent has none."
msgstr "Torrent đang tạm dừng thì không có."

