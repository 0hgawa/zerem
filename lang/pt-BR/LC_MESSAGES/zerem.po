# Zerem — Português do Brasil.
#
# Escrito à mão, não gerado. As chaves saem dos `@tr()` dos arquivos `.slint`;
# um `msgid` que não casar exatamente com o original cai de volta no inglês, em
# silêncio — então mexer numa string do `.slint` significa mexer aqui também.
#
# As frases em Rust (estados, unidades, causas de falha) não estão aqui: elas
# vivem em `zerem-core/src/text.rs` pelo motivo explicado lá.
msgid ""
msgstr ""
"Project-Id-Version: Zerem\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

