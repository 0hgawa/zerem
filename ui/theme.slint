// Zerem — M3-flavoured semantic tokens. No component ever writes a hex
// literal; every colour is named by role here so the light/dark swap is one
// boolean and the palette can be retuned in one place.
//
// Every pair drawn from here is contrast-checked against WCAG AA by
// `tests/contrast.rs`, which reads *this file* rather than a copy of the
// values. Retuning a colour either keeps it legible or turns CI red.
//
// That test is why the light theme's accent, seeding, warn and danger are
// darker than their dark-theme counterparts rather than the same hex. The
// dark theme passed on the first measurement; the light one failed nine pairs
// out of nineteen, `warn` worst at 1.98:1 — a mid-weight orange on a near-white
// ground cannot reach 4.5:1 and stay orange, so in the light theme it is amber
// instead. `idle` is held to 3:1 and not 4.5:1 on purpose: it is never a
// sentence, it is the bar of a paused torrent and the path of a file nobody
// asked for, and pushing it to the text bar would stop "switched off" reading
// as switched off.
export global Theme {
    in-out property <bool> dark: true;

    // --- surfaces ---
    //
    // Layers, not strokes. The window, the bars and the panels are told apart
    // by what they are filled with, which is how Fluent does it and how Edge
    // looks: a rule under a toolbar that is already a different colour from
    // the list below it is a line drawing a line. `border` survives for the
    // one place a line still means something — the separator between groups
    // in a menu, where merging "pause" into "remove" would be dangerous.
    // Content is paper, chrome is not. Which way round matters: they were a
    // hair apart — #f7f7fa against #ffffff is a ratio of 1.04 — and that was
    // invisible the moment the strokes came out. Separating by layer only works
    // if the layers can be told apart, so the list is white and the bars are
    // grey, the way a browser is grey around a white page.
    //
    // The values are grok.com's, read out of its stylesheet rather than picked
    // by eye: `--surface-base`, `--surface-l1` and `--surface-l2`. What makes
    // them read as they do is that they are *warm* — hue 20 to 36 at five to
    // fourteen per cent — where this palette used to be a cool blue-grey at
    // hue 240. Same lightness ramp, different temperature, and the whole app
    // stops looking like a dialog box.
    out property <brush> bg: dark ? #131211 : #fdfdfc;
    out property <brush> surface: dark ? #181716 : #f5f3f2;
    out property <brush> surface-hi: dark ? #201f1d : #eae8e6;
    // A panel raised on top of chrome, which is not the same direction in both
    // themes and was drawn as though it were. `surface-hi` means "one step
    // further from the window" — in the dark theme that is lighter, in the
    // light theme it is darker, and a settings card painted with it came out
    // as a grey block pressed into a grey dialog. A card rises: white on grey
    // in the light theme, the way every settings screen on this desktop draws
    // one, and the lighter grey in the dark theme where lighter is up.
    out property <brush> card: dark ? #282624 : #fdfdfc;
    // The stripe on every other row, and the two are set together because
    // they compete.
    //
    // It was 2.4% in the dark theme and 1.6% in the light one, which against
    // #fdfdfc is a ratio of 1.01 — a stripe that exists in the code and not on
    // the screen. Raising it alone is not enough either: hover was 3.9%, so
    // pointing at an odd row would have moved it from 3.1% to 3.9% and the
    // list would have stopped answering the cursor. Hover goes up with it, to
    // roughly twice the stripe, which is where Fluent puts a list hover.
    out property <brush> row-alt: dark ? #ffffff0a : #0f0d0a08;
    out property <brush> hover: dark ? #ffffff16 : #0f0d0a11;
    out property <brush> selected: dark ? #299fff26 : #0890ff1c;
    out property <brush> border: dark ? #ffffff0f : #0f0d0a0a;
    out property <brush> track: dark ? #ffffff12 : #0f0d0a0f;

    // --- content ---
    //
    // grok.com's `--fg-primary` and `--fg-secondary`, which are pure neutral
    // where the surfaces are warm. That combination is deliberate on their
    // side and worth copying: warm paper with neutral ink reads as paper,
    // where warm ink on warm paper reads as sepia.
    out property <brush> text: dark ? #fcfcfc : #050505;
    out property <brush> text-dim: dark ? #9e9e9e : #636363;

    // The accent is two roles, because grok.com draws it as two.
    //
    // `--wd-accent` is the sky blue on their buttons — a fill, with white on
    // top of it. `--link` is a different blue entirely, and it is the one they
    // set text in. Zerem had a single token doing both, and a fill colour used
    // as ink is exactly how the contrast test caught 4.31:1 earlier: a blue
    // bright enough to sit behind white is too bright to sit on it.
    out property <brush> accent: dark ? #859fff : #3352d5;
    out property <brush> accent-fill: dark ? #299fff : #0075d4;
    // What goes on top of that fill, and it is not white in both themes.
    //
    // grok.com's sky blue with white on it is 3.29:1 in the light theme and
    // 2.80:1 in the dark one — both under the 4.5:1 a button label needs, and
    // the second worse than the first because the dark theme's fill is the
    // brighter of the two. So the ink follows the fill's lightness, which is
    // what M3 means by an "on-" colour and what Fluent does too: the light
    // theme darkens the fill until white sits on it, and the dark theme keeps
    // grok's blue exactly and puts near-black on top.
    out property <brush> on-accent: dark ? #0a0a0a : #ffffff;
    out property <brush> seeding: dark ? #4ac68d : #0f7a48;
    out property <brush> warn: dark ? #efa23c : #8a5300;
    out property <brush> danger: dark ? #ff6b6b : #b3261e;
    // Halfway down grok.com's neutral ramp rather than a rung on it: their
    // #9e9e9e is the dark theme's secondary ink, and on light paper it comes
    // to 2.63:1 — under the 3:1 this is held to. Held to three and not the
    // text bar of 4.5 on purpose: idle is never a sentence, it is the bar of a
    // paused torrent and the path of a file nobody asked for, and pushing it
    // to the text bar would stop "switched off" reading as switched off.
    out property <brush> idle: dark ? #6f6c69 : #8a8a8a;

    // --- type ---
    //
    // Fluent 2, which is what Windows 11 and Edge are drawn in: caption 12,
    // body 14, and 16 for the one line that is a heading. It was 11/12/13 in
    // plain Segoe UI, which is the Windows 10 ramp — close enough to look
    // deliberate and far enough to look like a different application sitting
    // on the desktop.
    //
    // Segoe UI Variable ships as three optical sizes — Small for 8–12, Text
    // for 12–18, Display for 18 and up — and the whole ramp above lives inside
    // Text's range, so there is one family here rather than a token per size
    // and a choice at every call site.
    out property <string> font: "Segoe UI Variable Text";
    out property <length> fs-label: 12px;
    out property <length> fs-body: 14px;
    out property <length> fs-title: 16px;

    // 550 and not 600, which is grok.com's: they ship exactly two weights,
    // Universal Sans at 400 and at 550, and 550 is noticeably lighter than the
    // semibold most interfaces reach for. Segoe UI Variable is a variable font,
    // so the axis takes the number rather than snapping to the nearest cut.
    //
    // The typeface itself did not come across, and will not. Universal Sans is
    // licensed from Family Type and cannot be redistributed inside an
    // application. grok.com names Inter as its own fallback, which is OFL and
    // could be bundled — at about 300 KB a weight, 600 for the two this needs,
    // with no subsetting tool on hand to bring that down. Decided against: the
    // face Windows already has costs nothing, is the one every other window on
    // this desktop is set in, and carries the 550 weight on its own axis.
    out property <int> semibold: 550;

    // --- motion ---
    //
    // Two durations and two curves is the whole vocabulary. M3 publishes a
    // dozen of each; a table and a side panel need two, and a token nobody
    // spends is a token that drifts away from what the app actually does.
    //
    // The curves are M3's own: `standard` for something changing in place,
    // `emphasized` for something arriving or leaving — it overshoots the
    // deceleration, which is what makes a panel feel pushed rather than faded.
    out property <duration> quick: 90ms;
    out property <duration> panel: 240ms;
    // Functions and not properties: Slint cannot expose an `easing` across the
    // native boundary and warns about every global that tries, and a private
    // property would not be readable from the components that need it.
    public pure function ease-standard() -> easing { return cubic-bezier(0.2, 0.0, 0.0, 1.0); }
    public pure function ease-emphasized() -> easing { return cubic-bezier(0.05, 0.7, 0.1, 1.0); }

    // --- metrics ---
    // 32 and not 28: a 14 px line in a 28 px row is Fluent's own minimum with
    // nothing left over, and the row is the thing the cursor has to hit. It
    // costs about one row in eight on a full window, which is the price of the
    // list reading like the rest of the system.
    out property <length> row-h: 32px;
    out property <length> header-h: 32px;
    out property <length> radius: 8px;
}
