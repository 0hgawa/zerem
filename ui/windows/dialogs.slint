// The two dialogs that belong to the main window: preferences, and the one
// question the app asks before doing something it cannot undo for you.

import { Theme } from "../theme.slint";
import { Lucide } from "../components/icons.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { ScrollView } from "std-widgets.slint";
import { Check, Field, Modal, NumberField, SettingsGroup } from "../components/common.slint";
import { Prefs, TorrentList } from "../state.slint";

/// Everything the app will let somebody change, grouped and scrollable.
///
/// The three restart-only settings are here now, which reverses an earlier
/// call. The objection was right — a control that *silently* does nothing until
/// the next launch is worse than no control — and it was an argument against
/// the silence rather than against the control. Each of them says so on its
/// own line, so the panel is honest instead of incomplete.
export component Preferences inherits Modal {
    card-width: 560px;
    card-height: min(card.preferred-height, 620px);
    dismissed => { Prefs.close(); }

    card := VerticalLayout {
        padding: 22px;
        spacing: 14px;

        Text {
            text: @tr("Preferences");
            color: Theme.text;
            font-size: Theme.fs-title;
            font-family: Theme.font;
            font-weight: 600;
        }

        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.width;

            VerticalLayout {
                spacing: 15px;
                padding-right: 12px;
                alignment: start;

                SettingsGroup { text: @tr("Downloads"); }

                Field {
                    label: @tr("Save to");
                    value: Prefs.download-dir;
                    hint: @tr("Torrents already in the list keep their folder.");
                    action: @tr("Change");
                    glyph: Lucide.folder-open;
                    activated => { Prefs.pick-download-dir(); }
                }

                NumberField {
                    label: @tr("Download at once");
                    value: Prefs.max-active;
                    placeholder: @tr("No limit");
                    hint: @tr("The rest wait their turn. Seeding never waits.");
                    committed(text) => { Prefs.set-max-active(text); }
                }

                Check {
                    label: @tr("Add torrents stopped");
                    checked: Prefs.add-paused;
                    toggled(on) => { Prefs.set-add-paused(on); }
                }

                SettingsGroup { text: @tr("Speed"); }

                NumberField {
                    label: @tr("Download limit");
                    value: Prefs.down-limit;
                    unit: @tr("kB/s");
                    placeholder: @tr("Unlimited");
                    committed(text) => { Prefs.set-down-limit(text); }
                }

                NumberField {
                    label: @tr("Upload limit");
                    value: Prefs.up-limit;
                    unit: @tr("kB/s");
                    placeholder: @tr("Unlimited");
                    // The one that matters day to day, so it says why.
                    hint: @tr("An unlimited upload fills the uplink and stalls everything else on the connection.");
                    committed(text) => { Prefs.set-up-limit(text); }
                }

                SettingsGroup { text: @tr("Connection"); }

                NumberField {
                    label: @tr("Listening port");
                    value: Prefs.port;
                    placeholder: "6881";
                    hint: @tr("Takes effect the next time Zerem starts.");
                    committed(text) => { Prefs.set-port(text); }
                }

                Check {
                    label: @tr("uTP — yields to other traffic on the same line");
                    checked: Prefs.utp;
                    toggled(on) => { Prefs.set-utp(on); }
                }

                Check {
                    label: @tr("Ask the router to open the port (UPnP)");
                    checked: Prefs.upnp;
                    toggled(on) => { Prefs.set-upnp(on); }
                }

                Text {
                    text: @tr("Both take effect the next time Zerem starts.");
                    color: Theme.text-dim;
                    font-size: Theme.fs-label;
                    font-family: Theme.font;
                    wrap: word-wrap;
                }

                SettingsGroup { text: @tr("Appearance"); }

                Field {
                    label: @tr("Language");
                    value: Prefs.language;
                    action: @tr("Change");
                    glyph: Lucide.file-text;
                    activated => { Prefs.cycle-language(); }
                }

                Check {
                    label: @tr("Dark theme");
                    checked: Theme.dark;
                    // Through the same callback the toolbar button uses, so the
                    // choice is written down rather than only drawn.
                    toggled(on) => { TorrentList.toggle-theme(); }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            Button {
                label: @tr("Done");
                kind: ButtonKind.primary;
                clicked => { Prefs.close(); }
            }
        }
    }
}

/// Removing is the one destructive thing the app does, so it is the one action
/// that asks. Escape cancels, Enter confirms.
export component ConfirmRemove inherits Modal {
    card-width: 420px;
    card-height: card.preferred-height;
    dismissed => { TorrentList.confirm-cancel(); }

    card := VerticalLayout {
        padding: 22px;
        spacing: 14px;

        Text {
            text: TorrentList.confirm-what;
            color: Theme.text;
            font-size: Theme.fs-title;
            font-family: Theme.font;
            font-weight: 600;
            wrap: word-wrap;
        }

        Check {
            label: @tr("Also move the data to the recycle bin");
            checked <=> TorrentList.confirm-delete-data;
        }

        Text {
            text: TorrentList.confirm-delete-data
                ? @tr("The files go to the recycle bin, so this can be undone.")
                : @tr("The files stay where they are.");
            color: Theme.text-dim;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                label: @tr("Cancel");
                kind: ButtonKind.text;
                clicked => { TorrentList.confirm-cancel(); }
            }
            Button {
                label: @tr("Remove");
                glyph: Lucide.trash;
                kind: ButtonKind.danger;
                clicked => { TorrentList.confirm-accept(); }
            }
        }
    }
}
