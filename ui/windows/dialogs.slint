// The two dialogs that belong to the main window: preferences, and the one
// question the app asks before doing something it cannot undo for you.

import { Theme } from "../theme.slint";
import { Lucide } from "../components/icons.slint";
import { Button, ButtonKind, IconButton } from "../components/button.slint";
import { ScrollView } from "std-widgets.slint";
import {
    Check, Divider, Dropdown, Modal, NumberBox, RadioCard, RailItem, SettingsCard, SettingsGroup, SettingsRow, Toggle
} from "../components/common.slint";
import { Prefs, TorrentList, UpdateState } from "../state.slint";

/// Everything the app will let somebody change, one subject at a time.
///
/// It used to be a single scroll with four headings in it, which meant the way
/// to reach the listening port was to read past the speed limits. Four rooms
/// with a list of doors is how Windows itself lays this out, and it is better
/// for the same reason a table of contents is: the shape of what is on offer is
/// visible before anything is read.
///
/// Inside a room the rows are grouped onto cards, and each row says what it is
/// on the left and carries what changes it on the right. That is the shape of
/// every settings screen on this desktop, and it replaced a fixed label column
/// that made each row read as a field on a form rather than a choice.
///
/// The three restart-only settings are here, which reverses an earlier call.
/// The objection was right — a control that *silently* does nothing until the
/// next launch is worse than no control — and it was an argument against the
/// silence rather than against the control. Connection says so once, under the
/// card, covering all three.
export component Preferences inherits Modal {
    card-width: 790px;
    // Stated, not asked. The pane is a ScrollView, and a ScrollView reports a
    // small preferred height on purpose — hugging its content is the one thing
    // it exists not to do. Asking it collapsed the card to a title, a sliver of
    // list and the close button. The Modal still clamps this against the window,
    // so a short desktop gets a shorter dialog rather than one off the edge.
    card-height: 440px;
    closable: true;
    dismissed => { Prefs.close(); }

    /// Which room is open. Local rather than global: the dialog is rebuilt each
    /// time it opens, so it always opens on Downloads instead of wherever
    /// somebody happened to leave it a week ago.
    property <string> section: "general";

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 18px;

            // The same rail the main window uses for states, because it is the
            // same idea — and a second one drawn slightly differently is how an
            // interface starts to look assembled rather than designed.
            VerticalLayout {
                width: 168px;
                spacing: 2px;
                alignment: start;

                Text {
                    text: @tr("Preferences");
                    color: Theme.text;
                    font-size: Theme.fs-title;
                    font-family: Theme.font;
                    font-weight: Theme.semibold;
                    // Sits over the rail rather than over the whole card: it
                    // names the window, and what is on the right already has
                    // its own heading.
                    height: 38px;
                    vertical-alignment: center;
                }

                RailItem {
                    label: @tr("General");
                    glyph: Lucide.settings;
                    active: root.section == "general";
                    chosen => { root.section = "general"; }
                }
                RailItem {
                    label: @tr("Downloads");
                    glyph: Lucide.folder-open;
                    active: root.section == "downloads";
                    chosen => { root.section = "downloads"; }
                }
                RailItem {
                    label: @tr("Speed");
                    glyph: Lucide.zap;
                    active: root.section == "speed";
                    chosen => { root.section = "speed"; }
                }
                RailItem {
                    label: @tr("Connection");
                    glyph: Lucide.globe;
                    active: root.section == "connection";
                    chosen => { root.section = "connection"; }
                }
                RailItem {
                    label: @tr("About");
                    glyph: Lucide.info;
                    active: root.section == "about";
                    chosen => { root.section = "about"; }
                }
            }

            ScrollView {
                horizontal-stretch: 1;
                viewport-width: self.width;

                VerticalLayout {
                    spacing: 10px;
                    padding-right: 12px;
                    alignment: start;

                    // The room's own name, mirroring the door that was opened.
                    // Windows does this, and it is what tells somebody who
                    // clicked without reading where they have landed.
                    //
                    Text {
                        text: root.section == "general" ? @tr("General")
                            : root.section == "downloads" ? @tr("Downloads")
                            : root.section == "speed" ? @tr("Speed")
                            : root.section == "connection" ? @tr("Connection")
                            : @tr("About");
                        color: Theme.text;
                        font-size: Theme.fs-title;
                        font-family: Theme.font;
                        font-weight: Theme.semibold;
                        height: 38px;
                        vertical-alignment: center;
                    }

                    if root.section == "downloads": SettingsCard {
                        SettingsRow {
                            title: @tr("Save to");
                            subtitle: Prefs.download-dir;
                            Button {
                                label: @tr("Change");
                                glyph: Lucide.folder-open;
                                clicked => { Prefs.pick-download-dir(); }
                            }
                        }
                        Divider { }
                        SettingsRow {
                            title: @tr("Download at once");
                            subtitle: @tr("The rest wait their turn. Seeding never waits.");
                            NumberBox {
                                label: @tr("Download at once");
                                value: Prefs.max-active;
                                placeholder: @tr("No limit");
                                committed(text) => { Prefs.set-max-active(text); }
                            }
                        }
                        Divider { }
                        SettingsRow {
                            title: @tr("Move here when finished");
                            subtitle: Prefs.keep-dir == "" ? @tr("Finished torrents stay in the folder they downloaded to.")
                                : Prefs.keep-dir;
                            HorizontalLayout {
                                spacing: 6px;
                                if Prefs.keep-dir != "": Button {
                                    label: @tr("Off");
                                    kind: ButtonKind.text;
                                    clicked => { Prefs.clear-keep-dir(); }
                                }
                                Button {
                                    label: @tr("Change");
                                    glyph: Lucide.folder-open;
                                    clicked => { Prefs.pick-keep-dir(); }
                                }
                            }
                        }
                        Divider { }
                        SettingsRow {
                            title: @tr("Watch this folder");
                            subtitle: Prefs.watch-dir == ""
                                ? @tr("A .torrent file dropped in a watched folder is added on its own.")
                                : Prefs.watch-dir;
                            HorizontalLayout {
                                spacing: 6px;
                                if Prefs.watch-dir != "": Button {
                                    label: @tr("Off");
                                    kind: ButtonKind.text;
                                    clicked => { Prefs.clear-watch-dir(); }
                                }
                                Button {
                                    label: @tr("Change");
                                    glyph: Lucide.folder-open;
                                    clicked => { Prefs.pick-watch-dir(); }
                                }
                            }
                        }
                        Divider { }
                        SettingsRow {
                            title: @tr("Add torrents stopped");
                            Toggle {
                                on: Prefs.add-paused;
                                hint: @tr("Add torrents stopped");
                                toggled(on) => { Prefs.set-add-paused(on); }
                            }
                        }
                    }

                    if root.section == "speed": SettingsCard {
                        // Down and up together. The two alternates used to come
                        // between them, so the pair somebody actually came to
                        // set read as four unrelated fields.
                        SettingsRow {
                            title: @tr("Download limit");
                            NumberBox {
                                label: @tr("Download limit");
                                value: Prefs.down-limit;
                                unit: @tr("kB/s");
                                placeholder: @tr("Unlimited");
                                committed(text) => { Prefs.set-down-limit(text); }
                            }
                        }
                        Divider { }
                        SettingsRow {
                            title: @tr("Upload limit");
                            // The one that matters day to day, so it says why.
                            subtitle: @tr("An unlimited upload fills the uplink and stalls everything else on the connection.");
                            NumberBox {
                                label: @tr("Upload limit");
                                value: Prefs.up-limit;
                                unit: @tr("kB/s");
                                placeholder: @tr("Unlimited");
                                committed(text) => { Prefs.set-up-limit(text); }
                            }
                        }
                    }

                    // The caveat belongs to the folder above, and it is about
                    // what changing it will not do — a footnote, not a
                    // description of the row.
                    if root.section == "downloads": Text {
                        text: @tr("Changing this does not move torrents already in the list.");
                        color: Theme.text-dim;
                        font-size: Theme.fs-label;
                        font-family: Theme.font;
                        wrap: word-wrap;
                    }

                    if root.section == "speed": SettingsGroup { text: @tr("Alternative limits"); }

                    if root.section == "speed": SettingsCard {
                        SettingsRow {
                            title: @tr("Slow download");
                            // Said once, on the first of the pair, rather than
                            // hanging off whichever happened to be last.
                            subtitle: @tr("The second pair, for when the line is needed for something else. The button in the toolbar switches to them.");
                            NumberBox {
                                label: @tr("Slow download");
                                value: Prefs.alt-down-limit;
                                unit: @tr("kB/s");
                                placeholder: @tr("Unlimited");
                                committed(text) => { Prefs.set-alt-down-limit(text); }
                            }
                        }
                        Divider { }
                        SettingsRow {
                            title: @tr("Slow upload");
                            NumberBox {
                                label: @tr("Slow upload");
                                value: Prefs.alt-up-limit;
                                unit: @tr("kB/s");
                                placeholder: @tr("Unlimited");
                                committed(text) => { Prefs.set-alt-up-limit(text); }
                            }
                        }
                    }

                    if root.section == "connection": SettingsCard {
                        SettingsRow {
                            title: @tr("Listening port");
                            NumberBox {
                                label: @tr("Listening port");
                                value: Prefs.port;
                                placeholder: "6881";
                                committed(text) => { Prefs.set-port(text); }
                            }
                        }
                        Divider { }
                        SettingsRow {
                            title: @tr("uTP — yields to other traffic on the same line");
                            Toggle {
                                on: Prefs.utp;
                                hint: @tr("uTP — yields to other traffic on the same line");
                                toggled(on) => { Prefs.set-utp(on); }
                            }
                        }
                        Divider { }
                        SettingsRow {
                            title: @tr("Ask the router to open the port (UPnP)");
                            Toggle {
                                on: Prefs.upnp;
                                hint: @tr("Ask the router to open the port (UPnP)");
                                toggled(on) => { Prefs.set-upnp(on); }
                            }
                        }
                        Divider { }
                        SettingsRow {
                            title: @tr("Protocol encryption");
                            // What the third choice costs, said on the row that
                            // offers it. A plain connection announces itself in
                            // its first nineteen bytes, which is what equipment
                            // that throttles this reads -- but demanding
                            // encryption turns away every peer that will not,
                            // and on a healthy swarm that is most of the ones
                            // holding the data.
                            subtitle: Prefs.encryption == "require"
                                    ? @tr("Only peers that encrypt. Nothing on the wire says what this is, and there will be fewer peers.")
                                : Prefs.encryption == "prefer"
                                    ? @tr("Encrypt where the peer will. Hides the traffic from a connection that throttles BitTorrent.")
                                    : @tr("Never. Anything watching the line can see what this is.");
                            Dropdown {
                                options: [@tr("Never"), @tr("Prefer"), @tr("Require")];
                                current: Prefs.encryption == "require" ? 2
                                    : Prefs.encryption == "prefer" ? 1 : 0;
                                hint: @tr("Protocol encryption");
                                changed(at) => {
                                    Prefs.set-encryption(at == 2 ? "require" : at == 1 ? "prefer" : "off");
                                }
                            }
                        }
                    }

                    // Once, for all three. The port carried its own copy of
                    // this and the two switches another, so the same sentence
                    // was on screen twice.
                    // Said here rather than on the encryption row, because it
                    // is a consequence of that choice on a different row -- and
                    // a setting that silently switches another one off is the
                    // kind of thing somebody finds out about a month later.
                    if root.section == "connection" && Prefs.encryption != "off": Text {
                        text: @tr("Encryption uses TCP, so uTP is off while it is on.");
                        color: Theme.text-dim;
                        font-size: Theme.fs-label;
                        font-family: Theme.font;
                        wrap: word-wrap;
                    }

                    if root.section == "connection": Text {
                        text: @tr("These take effect the next time Zerem starts.");
                        color: Theme.text-dim;
                        font-size: Theme.fs-label;
                        font-family: Theme.font;
                        wrap: word-wrap;
                    }

                    // What the app is, before what it does. Theme and language
                    // are not "appearance" and "appearance" is not a home for
                    // whatever is left over — which is what that section had
                    // become: it held a reset that touches folders and limits.
                    if root.section == "general": VerticalLayout {
                        spacing: 10px;

                        Text {
                            text: @tr("Theme");
                            color: Theme.text-dim;
                            font-size: Theme.fs-label;
                            font-family: Theme.font;
                            font-weight: Theme.semibold;
                        }
                        // Cards rather than a switch, because a theme can be
                        // shown: the choice is three states and a two-state
                        // control could not hold the third at all.
                        HorizontalLayout {
                            spacing: 8px;
                            RadioCard {
                                glyph: Lucide.sun;
                                label: @tr("Light");
                                chosen: Prefs.theme == "light";
                                picked => { Prefs.pick-theme("light"); }
                            }
                            RadioCard {
                                glyph: Lucide.moon;
                                label: @tr("Dark");
                                chosen: Prefs.theme == "dark";
                                picked => { Prefs.pick-theme("dark"); }
                            }
                            RadioCard {
                                glyph: Lucide.monitor;
                                label: @tr("System");
                                chosen: Prefs.theme == "system";
                                picked => { Prefs.pick-theme("system"); }
                            }
                        }

                        SettingsCard {
                            SettingsRow {
                                title: @tr("Language");
                                subtitle: @tr("Every window changes at once. No restart.");
                                Dropdown {
                                    options: Prefs.languages;
                                    current: Prefs.language-index;
                                    hint: @tr("Language");
                                    changed(at) => { Prefs.set-language(at); }
                                }
                            }
                        }
                    }

                    if root.section == "about": VerticalLayout {
                        spacing: 10px;

                        SettingsCard {
                            SettingsRow {
                                title: "Zerem";
                                subtitle: @tr("A BitTorrent client that does not get in the way.");
                                Text {
                                    text: Prefs.version;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-label;
                                    font-family: Theme.font;
                                    vertical-alignment: center;
                                }
                            }
                            Divider { }
                            SettingsRow {
                                title: @tr("Engine");
                                subtitle: @tr("librqbit, and the flags come from what the five internet registries publish.");
                                Text {
                                    text: Prefs.engine;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-label;
                                    font-family: Theme.font;
                                    vertical-alignment: center;
                                }
                            }
                            Divider { }
                            SettingsRow {
                                title: @tr("Updates");
                                // One line that always says where things stand,
                                // rather than a label that never changes and a
                                // result that turns up somewhere else. The two
                                // install kinds come first: for those there is
                                // nothing a check could tell anybody, because
                                // the answer is already known and it is no.
                                subtitle: Prefs.install-kind == "sandboxed"
                                        ? @tr("Installed in a sandbox — updates arrive with the runtime.")
                                    : Prefs.install-kind == "managed"
                                        ? @tr("Installed for everybody on this machine — updates come from your package manager.")
                                    : Prefs.update == UpdateState.checking
                                        ? @tr("Looking…")
                                    : Prefs.update == UpdateState.current
                                        ? @tr("This is the newest version.")
                                    : Prefs.update == UpdateState.available
                                        ? @tr("Version {} is ready to install.", Prefs.update-detail)
                                    : Prefs.update == UpdateState.installing
                                        ? @tr("Downloading, and checking who signed it…")
                                    : Prefs.update == UpdateState.installed
                                        ? @tr("Installed. Restart to run it.")
                                    : Prefs.update == UpdateState.failed
                                        ? @tr("Could not update: {}", Prefs.update-detail)
                                    : @tr("Looked for automatically each time the app opens.");

                                HorizontalLayout {
                                    spacing: 6px;

                                    // Offered when the app cannot install an
                                    // update itself, and when one failed — the
                                    // two cases where the next step is a
                                    // browser rather than this window.
                                    if Prefs.install-kind != "self" || Prefs.update == UpdateState.failed: Button {
                                        label: @tr("Releases");
                                        glyph: Lucide.external-link;
                                        kind: ButtonKind.text;
                                        clicked => { Prefs.open-releases(); }
                                    }

                                    // Only a copy that can rewrite its own
                                    // binary gets this. Anywhere else it would
                                    // download, verify, and then fail on the
                                    // user's own filesystem — which is worse
                                    // than never offering an update at all.
                                    if Prefs.install-kind == "self": Button {
                                        label: Prefs.update == UpdateState.installed ? @tr("Restart now")
                                            : Prefs.update == UpdateState.available ? @tr("Install")
                                            : Prefs.update == UpdateState.installing ? @tr("Installing…")
                                            : Prefs.update == UpdateState.checking ? @tr("Looking…")
                                            : @tr("Check now");
                                        glyph: Prefs.update == UpdateState.installed ? Lucide.rotate-cw
                                            : Prefs.update == UpdateState.available ? Lucide.download
                                            : Lucide.refresh-cw;
                                        // The one filled button in this window.
                                        // Everything else here is a setting
                                        // somebody came to change; this is the
                                        // app asking for something, and only
                                        // when it actually has something to ask.
                                        kind: Prefs.update == UpdateState.available || Prefs.update == UpdateState.installed
                                            ? ButtonKind.primary : ButtonKind.tonal;
                                        // Nothing to press while it is working.
                                        enabled: Prefs.update != UpdateState.checking && Prefs.update != UpdateState.installing;
                                        clicked => {
                                            if (Prefs.update == UpdateState.installed) {
                                                Prefs.relaunch();
                                            } else if (Prefs.update == UpdateState.available) {
                                                Prefs.install-update();
                                            } else {
                                                Prefs.check-update();
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // The reset lives here, not under a heading about how
                        // the app looks. It puts folders, limits and the port
                        // back as well, and none of those are appearance.
                        SettingsCard {
                            SettingsRow {
                                title: @tr("Put every setting back");
                                subtitle: Prefs.resetting
                                    ? @tr("Every preference returns to what it was on the first launch. Torrents are not touched.")
                                    : @tr("Folders, limits, language and theme — all of it.");
                                HorizontalLayout {
                                    spacing: 6px;
                                    if Prefs.resetting: Button {
                                        label: @tr("Cancel");
                                        kind: ButtonKind.text;
                                        clicked => { Prefs.resetting = false; }
                                    }
                                    Button {
                                        label: Prefs.resetting ? @tr("Reset everything") : @tr("Reset…");
                                        glyph: Lucide.loader;
                                        kind: ButtonKind.danger;
                                        // Asked in place rather than over a
                                        // dialog: the row is what it is about,
                                        // and a modal over a modal is a stack
                                        // nobody enjoys. Two presses, and the
                                        // second names the thing — the shape
                                        // Remove already uses on a torrent.
                                        clicked => {
                                            if (Prefs.resetting) {
                                                Prefs.reset-all();
                                            } else {
                                                Prefs.resetting = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

    }
}

/// Removing is the one destructive thing the app does, so it is the one action
/// that asks. Escape cancels, Enter confirms.
export component ConfirmRemove inherits Modal {
    card-width: 420px;
    card-height: card.preferred-height;
    dismissed => { TorrentList.confirm-cancel(); }

    card := VerticalLayout {
        padding: 22px;
        spacing: 14px;

        Text {
            text: TorrentList.confirm-what;
            color: Theme.text;
            font-size: Theme.fs-title;
            font-family: Theme.font;
            font-weight: Theme.semibold;
            wrap: word-wrap;
        }

        Check {
            label: @tr("Also move the data to the recycle bin");
            checked <=> TorrentList.confirm-delete-data;
        }

        Text {
            text: TorrentList.confirm-delete-data
                ? @tr("The files go to the recycle bin, so this can be undone.")
                : @tr("The files stay where they are.");
            color: Theme.text-dim;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                label: @tr("Cancel");
                kind: ButtonKind.text;
                clicked => { TorrentList.confirm-cancel(); }
            }
            Button {
                label: @tr("Remove");
                glyph: Lucide.trash;
                kind: ButtonKind.danger;
                clicked => { TorrentList.confirm-accept(); }
            }
        }
    }

}
