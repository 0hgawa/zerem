// The window: a toolbar, the list, a drawer, a status bar. Everything else is a
// component — this file composes, it does not draw.

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import {
    AddState, Brand, DetailState, Hint, Prefs, Row, SessionState, Shell, TorrentList
} from "../state.slint";
import { TableHeader, TableRow } from "../components/table.slint";
import { DetailDrawer } from "../components/detail.slint";
import { ColumnsMenu, ContextMenu, FileMenu } from "../components/menu.slint";
import { AddDialog } from "../components/add.slint";
import { Lucide } from "../components/icons.slint";
import { Button, ButtonKind, IconButton } from "../components/button.slint";
import { EmptyState, RailItem, SearchField, Sparkline, Stat, Tooltip } from "../components/common.slint";
import { ConfirmRemove, Preferences } from "dialogs.slint";
import { DragBand, Grip, WindowControls } from "../components/chrome.slint";

component Toolbar inherits Rectangle {
    /// Ctrl+F lands here. The field is nested two layouts deep, so the window
    /// reaches it through the toolbar rather than through a global — an element
    /// reference is the one thing a global cannot hold.
    public function focus-search() { search.take-focus(); }
    /// Escape in the field. The window answers by taking the keyboard back.
    callback dismissed;
    height: 48px;
    background: Theme.surface;

    // Behind everything else in the bar, so the gaps move the window and every
    // button drawn over it keeps its own clicks.
    DragBand { }

    HorizontalLayout {
        padding-left: 10px;
        // Two groups and a gap, stated rather than hoped for.
        //
        // Neither way of aligning one flat row does what a bar with a left and
        // a right side needs. `alignment: start` packs everything left and
        // ignores stretch, so the right-hand group rested in the middle;
        // removing the alignment lets Slint hand spare width to every child
        // that will take it, which spreads the whole bar out. So the two sides
        // are groups that cannot grow, and one element between them whose only
        // job is to be the leftover.
        spacing: 0px;

        // --- the app, and what is added to it ---
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 6px;

        // The app's mark, and the first thing in the window. It exists — it is
        // in the taskbar and the `.ico` — and the window never wore it, which
        // is most of why the header could have belonged to anything.
        //
        // No wordmark beside it: the title bar directly above already says
        // Zerem, and saying it twice in forty pixels is not identity.
        VerticalLayout {
            alignment: center;
            Image {
                source: Brand.mark;
                width: 20px;
                height: 20px;
                image-fit: contain;
                accessible-role: image;
                accessible-label: "Zerem";
            }
        }
        Rectangle { width: 4px; }

        // Then the fold, hard against the left, because that is where the thing
        // it opens is. It used to sit at the far right among the preferences
        // and the theme switch, a control for the left of the window living on
        // the right of the toolbar — every application on this desktop puts
        // this button over the panel it reveals.
        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Lucide.panel-left;
                label: TorrentList.rail-open ? @tr("Hide the state list") : @tr("Show the state list");
                tip: TorrentList.rail-open ? @tr("Hide the state list") : @tr("Show the state list");
                tint: TorrentList.rail-open ? Theme.accent : Theme.text-dim;
                clicked => { TorrentList.toggle-rail(); }
            }
        }
        Rectangle { width: 4px; }

        VerticalLayout {
            alignment: center;
            Button {
                label: @tr("Paste magnet");
                glyph: Lucide.clipboard;
                clicked => { TorrentList.add-magnet-from-clipboard(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                label: @tr("Add file");
                glyph: Lucide.plus;
                clicked => { TorrentList.add-torrent-file(); }
            }
        }

        // Nothing here acts on the selection any more, and nothing here is ever
        // disabled — which was the argument. Start/pause and Remove were both
        // greyed out whenever nothing was selected, and nothing selected is what
        // the window looks like most of the time.
        //
        // Every route to them survives: the play/pause that appears on the row
        // under the cursor, the right-click menu, Space and Delete. And Remove
        // is the one destructive thing the app does — parked permanently beside
        // "Add file", it was a slip waiting to happen.

        }

        // The gap, and the only thing allowed to have it.
        Rectangle { horizontal-stretch: 1; }

        // --- looking, and the window itself ---
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 6px;

        VerticalLayout {
            alignment: center;
            search := SearchField {
                text <=> TorrentList.filter;
                placeholder: @tr("Filter");
                edited(text) => { TorrentList.filter-changed(text); }
                dismissed => { root.dismissed(); }
            }
        }
        Rectangle { width: 6px; }

        // The slow-limits switch used to be here. It moved to the footer, beside
        // the two speeds it changes — where qBittorrent, Transmission and
        // Deluge all keep it, and where it stops needing to be explained: a
        // turtle next to ↓ and ↑ is about those numbers, and a turtle among the
        // theme switch and the preferences is about nothing in particular.
        // Somebody asked what it was twice while it was up here.
        // The details panel has no button here any more. It is not a view of
        // the window, it is a view of one torrent: clicking a row opens it and
        // its own × closes it. A global switch for something that is always
        // *about* a selected row is a switch that does nothing half the time
        // somebody presses it.
        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Theme.dark ? Lucide.sun : Lucide.moon;
                label: Theme.dark ? @tr("Switch to the light theme") : @tr("Switch to the dark theme");
                tip: Theme.dark ? @tr("Switch to the light theme") : @tr("Switch to the dark theme");
                clicked => { TorrentList.toggle-theme(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Lucide.settings;
                label: @tr("Preferences");
                tip: @tr("Preferences");
                clicked => { Prefs.open = true; }
            }
        }

        // The three, hard against the right edge and the full height of the
        // bar, which is where every window on this desktop keeps them. No gap
        // before them and none after: the corner itself is the target.
            WindowControls { }
        }
    }

}

component StatusBar inherits Rectangle {
    height: 34px;
    background: Theme.surface;
    border-radius: Theme.radius-float;

    // Two groups and a gap, stated rather than hoped for.
    //
    // This was one flat row, and neither way of aligning a flat row does what a
    // status bar needs. `alignment: start` packs everything left and ignores
    // stretch entirely, so the right-hand group came to rest in the middle.
    // Removing it lets Slint hand the spare width to *every* child that will
    // take it, which spread the whole bar out with gaps between the numbers.
    //
    // So: a left group, a right group, and one element between them whose only
    // job is to be the leftover. Nothing else can grow, so nothing else does.
    HorizontalLayout {
        padding-left: 12px;
        // Small, because the last thing in the bar is a round button and the
        // room around its circle is its own padding.
        padding-right: 4px;
        spacing: 0px;

        // --- what the session is doing ---
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 14px;

            Stat {
                glyph: Lucide.arrow-down;
                value: SessionState.down;
                hint: @tr("Download speed");
                tint: Theme.accent;
            }
            Stat {
                glyph: Lucide.arrow-up;
                value: SessionState.up;
                hint: @tr("Upload speed");
                tint: Theme.seeding;
            }

            // Beside the two figures it plots, not off in a corner: the line is
            // what the numbers mean over time, and reading them together is the
            // whole point of drawing it at all.
            if SessionState.spark-down != "": VerticalLayout {
                alignment: center;
                Sparkline {
                    down: SessionState.spark-down;
                    up: SessionState.spark-up;
                }
            }

            // The counts, with the speeds. Every one of these is a number to
            // read, and the rule this bar keeps now is that the left side is
            // read and the right side is pressed.
            //
            // The same three marks the list already uses for these states, so
            // the bar is read with knowledge the table has taught.
            Stat {
                glyph: Lucide.play;
                value: SessionState.active;
                hint: @tr("Active");
                tint: Theme.text-dim;
            }
            Stat {
                glyph: Lucide.pause;
                value: SessionState.paused;
                hint: @tr("Paused");
                tint: Theme.text-dim;
            }
            if SessionState.matched == "": Stat {
                glyph: Lucide.files;
                value: SessionState.total;
                hint: @tr("Total");
                tint: Theme.text-dim;
            }
            // Replaces the total rather than joining it, and takes the accent:
            // what it says is "you are not looking at all of them".
            if SessionState.matched != "": Stat {
                glyph: Lucide.search;
                value: SessionState.matched;
                hint: @tr("Matching the filter");
                tint: Theme.accent;
            }
        }

        // Errors that belong to no row land here rather than in a popup: a
        // failed paste should not interrupt anything. It is also the gap — the
        // one thing in the bar allowed to take the width nothing else wants.
        Text {
            text: SessionState.notice;
            color: Theme.danger;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            horizontal-alignment: center;
        }

        // --- and the one thing that can be pressed ---
        //
        // On its own, which is what makes it obvious. It had a hairline in
        // front of it while it shared this side with the counts; with the
        // counts gone to the readouts where they belong, the gap is the
        // separator and a line as well would be saying it twice.
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            IconButton {
                glyph: Lucide.gauge-low;
                diameter: 26px;
                label: Prefs.alt-speed ? @tr("Back to the full speed limits")
                    : @tr("Switch to the slow limits");
                tip: Prefs.alt-speed ? @tr("Back to the full speed limits")
                    : @tr("Switch to the slow limits");
                tint: Prefs.alt-speed ? Theme.warn : Theme.text-dim;
                clicked => { Prefs.toggle-alt-speed(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Zerem";
    // The frame is the application's now. Windows gave a title bar with a name
    // it already knows, an icon it already shows in the taskbar, and thirty
    // pixels of grey above everything this app actually is — see
    // `components/chrome.slint` for what had to be drawn back, and what it
    // costs.
    no-frame: true;
    background: Theme.ground;
    default-font-family: Theme.font;
    preferred-width: 1180px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 420px;

    forward-focus: keys;

    property <bool> has-selection: TorrentList.selected-count > 0;

    /// How far open the panel is. Animated here rather than on the width
    /// itself, so a drag on the edge stays pinned to the cursor: the width is
    /// computed from this, and only this moves on its own.
    property <float> reveal: DetailState.open ? 1.0 : 0.0;
    animate reveal { duration: Theme.panel; easing: Theme.ease-emphasized(); }

    keys := FocusScope {
        key-pressed(e) => {
            // Whatever is modal owns the keyboard: nothing behind it should
            // react to a keypress aimed at what is on screen.
            if (TorrentList.confirming) {
                if (e.text == Key.Escape) { TorrentList.confirm-cancel(); return accept; }
                if (e.text == Key.Return) { TorrentList.confirm-accept(); return accept; }
                if (e.text == Key.Tab) { return reject; }
                return accept;
            }
            if (AddState.open) {
                if (e.text == Key.Escape) { AddState.cancel(); return accept; }
                if (e.text == Key.Return && AddState.can-add) { AddState.confirm(); return accept; }
                // Tab is the focus's, not the window's. Everything else is
                // swallowed while a dialog is up — which is the point — but
                // swallowing this one leaves a dialog full of fields that can
                // only be reached with the mouse.
                if (e.text == Key.Tab) { return reject; }
                return accept;
            }
            if (Prefs.open) {
                if (e.text == Key.Escape || e.text == Key.Return) { Prefs.close(); return accept; }
                if (e.text == Key.Tab) { return reject; }
                return accept;
            }
            if (TorrentList.columns-open) {
                TorrentList.close-columns();
                return accept;
            }
            // The way out of the panel, now that clicking the row again is not.
            // Escape closes the innermost open thing everywhere else in this
            // window, and the panel was the last one that did not answer to it.
            if (e.text == Key.Escape && DetailState.open) {
                DetailState.close();
                return accept;
            }
            if (TorrentList.menu-open) {
                TorrentList.close-menu();
                return accept;
            }

            if (e.text == "v" && e.modifiers.control) {
                TorrentList.add-magnet-from-clipboard();
                return accept;
            }
            if (e.text == "o" && e.modifiers.control) {
                TorrentList.add-torrent-file();
                return accept;
            }
            if (e.text == "," && e.modifiers.control) {
                Prefs.open = true;
                return accept;
            }
            if (e.text == "f" && e.modifiers.control) {
                bar.focus-search();
                return accept;
            }
            if (e.text == "i" && e.modifiers.control && root.has-selection) {
                TorrentList.toggle-details();
                return accept;
            }

            // Arrows walk the list, Shift extends the run. Ctrl is deliberately
            // absent: "move without selecting" needs a focus ring the table does
            // not have yet, and a modifier that silently does nothing is worse
            // than one that is not offered.
            if (e.text == Key.UpArrow) { TorrentList.move-focus(-1, e.modifiers.shift); return accept; }
            if (e.text == Key.DownArrow) { TorrentList.move-focus(1, e.modifiers.shift); return accept; }
            if (e.text == Key.Home) { TorrentList.focus-edge(0, e.modifiers.shift); return accept; }
            if (e.text == Key.End) { TorrentList.focus-edge(-1, e.modifiers.shift); return accept; }

            if (e.text == " " && root.has-selection) {
                if (TorrentList.selection-running) {
                    TorrentList.pause-selected();
                } else {
                    TorrentList.start-selected();
                }
                return accept;
            }
            if (e.text == Key.Delete && root.has-selection) {
                TorrentList.remove-selected();
                return accept;
            }
            // The same thing double-clicking a file does everywhere else. It is
            // the last of the four verbs the list offers to reach the keyboard.
            if (e.text == Key.Return && root.has-selection) {
                TorrentList.open-folder();
                return accept;
            }
            if (e.text == "a" && e.modifiers.control) {
                TorrentList.select-all();
                return accept;
            }
            if (e.text == "t") { TorrentList.toggle-theme(); return accept; }
            return reject;
        }

        // Cards on a ground, not slabs welded together.
        //
        // Every torrent client is a grey bar stuck to a table stuck to a
        // footer, all of it running into the window's edges, and that shape is
        // most of why one looks like another. Windows 11 does not compose that
        // way: its Settings, its Start menu, its flyouts are rounded surfaces
        // floating on a background with room around them, and the room is what
        // you actually see.
        //
        // So the window's own colour shows through in an eight-pixel gutter,
        // and the toolbar, the rail, the list and the panel are four separate
        // cards sitting on it. Nothing was removed to do this: the same
        // controls, laid out as objects rather than as regions.
        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-bottom: 8px;
            spacing: 8px;

            // The header reaches the window's edges, and the cards start below
            // it. It is the title bar now: the close button belongs in the
            // actual corner, where it can be hit by throwing the pointer at it
            // without looking, and a title bar inset by eight pixels is a title
            // bar you have to aim for.
            //
            // Its top corners are the window's, cut by the desktop.
            bar := Toolbar {
                dismissed => { keys.focus(); }
            }

            // The panel takes width from the table rather than height, so the
            // list keeps every row it had.
            HorizontalLayout {
                spacing: 8px;

                // The rail. Where a browser puts its sidebar and where every
                // other client puts this, so it is where the hand goes looking.
                // The counts are what earn it the width: they answer "is
                // anything stuck?" without a click.
                if TorrentList.rail-open: Rectangle {
                    width: 166px;
                    background: Theme.surface;
                    border-radius: Theme.radius-float;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        alignment: start;
                        RailItem {
                            label: @tr("All");
                            glyph: Lucide.files;
                            count: SessionState.total;
                            active: TorrentList.shown == 0;
                            chosen => { TorrentList.show-state(0); }
                        }
                        RailItem {
                            label: @tr("Downloading");
                            glyph: Lucide.arrow-down;
                            count: SessionState.downloading;
                            active: TorrentList.shown == 1;
                            tint: Theme.accent;
                            chosen => { TorrentList.show-state(1); }
                        }
                        RailItem {
                            label: @tr("Seeding");
                            glyph: Lucide.arrow-up;
                            count: SessionState.seeding;
                            active: TorrentList.shown == 2;
                            tint: Theme.seeding;
                            chosen => { TorrentList.show-state(2); }
                        }
                        RailItem {
                            label: @tr("Queued");
                            glyph: Lucide.loader;
                            count: SessionState.queued;
                            active: TorrentList.shown == 3;
                            chosen => { TorrentList.show-state(3); }
                        }
                        RailItem {
                            label: @tr("Paused");
                            glyph: Lucide.pause;
                            count: SessionState.paused;
                            active: TorrentList.shown == 4;
                            chosen => { TorrentList.show-state(4); }
                        }
                        RailItem {
                            label: @tr("Error");
                            glyph: Lucide.triangle-alert;
                            count: SessionState.failed;
                            active: TorrentList.shown == 5;
                            tint: Theme.danger;
                            chosen => { TorrentList.show-state(5); }
                        }

                        // The shelves, under the states and only once there is
                        // one. An empty heading over an empty list is a
                        // promise the app has not kept yet.
                        if TorrentList.categories.length > 0: Rectangle {
                            height: 22px;
                            HorizontalLayout {
                                padding-left: 9px;
                                VerticalLayout {
                                    alignment: end;
                                    Text {
                                        text: @tr("Categories");
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-label;
                                        font-family: Theme.font;
                                        font-weight: Theme.semibold;
                                    }
                                }
                            }
                        }
                        for c in TorrentList.categories: RailItem {
                            label: c.name;
                            glyph: Lucide.folder-open;
                            count: c.count;
                            active: c.active;
                            tint: Theme.warn;
                            // Clicking the one already on widens back, which is
                            // the only way out that does not need a second
                            // control saying "all".
                            chosen => { TorrentList.show-category(c.active ? "" : c.name); }
                        }
                    }
                }

                // `min-width: 0` and `clip` are what make the panel possible at
                // all. The columns are fixed widths, so this layout's natural
                // minimum is their sum — and a layout that cannot go below its
                // minimum does not shrink, it pushes its sibling off the far
                // edge of the window. The panel was being cut in half by a
                // table refusing to give up a column it was not showing
                // anything urgent in.
                //
                // So the table yields and the last columns go under the panel,
                // which is the trade the side panel was chosen for: a panel
                // beneath the table costs rows, a panel beside it costs the
                // rightmost columns, and those are the least urgent ones.
                // Narrow a column or close the panel to get them back.
                Rectangle {
                    horizontal-stretch: 1;
                    // And vertically, unconditionally. It used to inherit the
                    // height from whatever inside the band happened to stretch,
                    // which was the panel's file list — so folding that list away
                    // left nothing claiming the height and the whole band
                    // collapsed to its preferred size, taking the table with it.
                    // The list is the app; it claims the height on its own.
                    vertical-stretch: 1;
                    min-width: 240px;
                    // The list is the paper this app is about, so it is the one
                    // card that is not chrome-coloured.
                    background: Theme.bg;
                    border-radius: Theme.radius-float;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;

                        TableHeader { }

                        // Three sentences, because there are three different
                        // things that leave the table empty and only one of
                        // them is "you have not added anything". Offering to
                        // paste a magnet link to somebody who narrowed to
                        // Paused and has nothing paused is the app not knowing
                        // where it is.
                        if TorrentList.rows.length == 0 && !TorrentList.narrowed: EmptyState {
                            glyph: Lucide.folder-open;
                            title: @tr("No torrents yet");
                            detail: @tr("Paste a magnet link with Ctrl+V, or add a .torrent file.");
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Button {
                                    label: @tr("Paste magnet");
                                    glyph: Lucide.clipboard;
                                    kind: ButtonKind.primary;
                                    clicked => { TorrentList.add-magnet-from-clipboard(); }
                                }
                                Button {
                                    label: @tr("Add .torrent file");
                                    glyph: Lucide.plus;
                                    clicked => { TorrentList.add-torrent-file(); }
                                }
                            }
                        }

                        // Typed words that match nothing. The most specific of
                        // the three, so it is tested first, and its button
                        // clears only the search — if the rail is narrowed too
                        // the next sentence takes over and offers the rest.
                        if TorrentList.rows.length == 0 && TorrentList.filter != "": EmptyState {
                            glyph: Lucide.search;
                            title: @tr("Nothing matches");
                            detail: @tr("No torrent's name contains every word you typed.");
                            HorizontalLayout {
                                alignment: center;
                                Button {
                                    label: @tr("Clear filter");
                                    glyph: Lucide.x;
                                    kind: ButtonKind.primary;
                                    clicked => {
                                        TorrentList.filter = "";
                                        TorrentList.filter-changed("");
                                    }
                                }
                            }
                        }

                        // Narrowed by the rail or a category, with nothing in
                        // it. There are torrents; none of them are here.
                        if TorrentList.rows.length == 0 && TorrentList.narrowed
                            && TorrentList.filter == "": EmptyState {
                            glyph: Lucide.folder-open;
                            title: @tr("Nothing here");
                            detail: @tr("You have torrents, just none in this part of the list.");
                            HorizontalLayout {
                                alignment: center;
                                Button {
                                    label: @tr("Show all");
                                    glyph: Lucide.files;
                                    kind: ButtonKind.primary;
                                    clicked => { TorrentList.show-all(); }
                                }
                            }
                        }

                        if TorrentList.rows.length > 0: list := ListView {
                            // Keeps the arrow-key row on screen. Fired by
                            // `focus-tick` rather than by `focus-row`, so holding an
                            // arrow at the top or bottom of the list still scrolls
                            // when the row does not move.
                            property <int> tick: TorrentList.focus-tick;
                            changed tick => {
                                if (TorrentList.focus-row >= 0) {
                                    self.viewport-y = clamp(
                                        self.viewport-y,
                                        self.visible-height - (TorrentList.focus-row + 1) * Theme.row-h,
                                        -TorrentList.focus-row * Theme.row-h);
                                }
                            }
                            for r[i] in TorrentList.rows: TableRow {
                                data: r;
                                index: i;
                            }
                        }
                    }
                }

                // Dragged, not fixed, and never a share of the window: the window
                // derives its own width from what its children ask for, so a
                // child asking for a fraction of the window asks about itself.
                // That is a binding loop, and Slint says so — it was tried.
                //
                // Bounds rather than a fixed `width`, which is what keeps the
                // two of them inside the window without either one measuring
                // it. The layout hands out the minimums first, grows each to
                // what it prefers, and gives the leftover to the table, which
                // is the one that stretches. On a window too narrow for both,
                // the panel falls back to its floor instead of hanging off the
                // right edge — which is what it used to do.
                // Always here, never `if`: an element cannot be animated into
                // existence. Closed is `reveal` at zero, which is a slot of no
                // width — the engine still stops building the lists inside, so
                // what stays is an empty shell, not a hidden panel.
                DetailDrawer {
                    // Same reason, from the other side: the panel keeps the full
                    // height whatever is or is not inside it.
                    vertical-stretch: 1;
                    horizontal-stretch: 0;
                    min-width: root.reveal * 240px;
                    preferred-width: root.reveal * DetailState.width;
                    max-width: root.reveal * DetailState.width;
                    full-width: DetailState.width;
                }
            }

            StatusBar { }
        }

        // The resize borders the frame took with it, drawn back.
        //
        // Six pixels, which is what Windows gives an invisible resize border:
        // wider is easier to hit and starts taking clicks from the content at
        // the edge. Above the cards and below anything floating, so a menu or a
        // dialog covers them rather than being resized through.
        //
        // Off while maximised, where there is no edge to pull.
        if !Shell.maximized: Rectangle {
            background: transparent;
            Grip { x: 0; y: 6px; width: 6px; height: parent.height - 12px; edges: 1; cursor: ew-resize; }
            Grip {
                x: parent.width - 6px;
                y: 6px;
                width: 6px;
                height: parent.height - 12px;
                edges: 2;
                cursor: ew-resize;
            }
            Grip { x: 6px; y: 0; width: parent.width - 12px; height: 6px; edges: 4; cursor: ns-resize; }
            Grip {
                x: 6px;
                y: parent.height - 6px;
                width: parent.width - 12px;
                height: 6px;
                edges: 8;
                cursor: ns-resize;
            }
            // The corners, each pulling two edges at once.
            Grip { x: 0; y: 0; width: 6px; height: 6px; edges: 5; cursor: nwse-resize; }
            Grip { x: parent.width - 6px; y: 0; width: 6px; height: 6px; edges: 6; cursor: nesw-resize; }
            Grip { x: 0; y: parent.height - 6px; width: 6px; height: 6px; edges: 9; cursor: nesw-resize; }
            Grip {
                x: parent.width - 6px;
                y: parent.height - 6px;
                width: 6px;
                height: 6px;
                edges: 10;
                cursor: nwse-resize;
            }
        }

        // Declared last so they draw over everything, innermost question last:
        // if two were somehow up, the one that has to be answered is on top.
        if Prefs.open: Preferences { width: root.width; height: root.height; }
        if TorrentList.menu-open: ContextMenu { width: root.width; height: root.height; }
        if TorrentList.columns-open: ColumnsMenu { width: root.width; height: root.height; }
        // Over the whole window, not inside the panel: a menu opened on the
        // last file of a long list has to be allowed to hang past its edge.
        if DetailState.file-menu-open: FileMenu { width: root.width; height: root.height; }
        // Last, and at the top level: a control cannot paint outside itself
        // under partial software rendering without leaving a hole behind it.
        if Hint.text != "": Tooltip { width: root.width; height: root.height; }
        if AddState.open: AddDialog { width: root.width; height: root.height; }
        if TorrentList.confirming: ConfirmRemove { width: root.width; height: root.height; }
    }
}
