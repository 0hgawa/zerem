// The floating menus.
//
// Two of them now, so the scrim and the card they share are a component rather
// than the same thirty lines twice. Both exist for the same reason: the thing
// under the cursor is where the hand already is, and making someone travel to a
// toolbar to act on what they are pointing at is the small friction that adds up.

import { Theme } from "../theme.slint";
import { DetailState, FileEntry, TorrentList } from "../state.slint";
import { Icon, Lucide } from "icons.slint";

component Item inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <string> shortcut;
    in property <bool> danger;
    in property <bool> enabled: true;
    /// Whether choosing this closes the menu. A toggle does not: hiding three
    /// columns should be three clicks, not three trips back to a right-click.
    in property <bool> closes: true;
    callback chosen;

    // 32 and not 28, and the highlight inset from the card rather than run to
    // its edges: those two numbers are most of what a Windows 11 flyout is.
    // A full-bleed hover inside a rounded card leaves square corners poking
    // into round ones, which is the detail that makes a menu look old.
    height: 32px;

    Rectangle {
        x: 4px;
        width: parent.width - 8px;
        height: parent.height - 2px;
        y: 1px;
        border-radius: Theme.radius;
        background: ta.has-hover && root.enabled ? Theme.hover : transparent;
        animate background { duration: Theme.quick; easing: Theme.ease-standard(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                tint: !root.enabled ? Theme.idle : root.danger ? Theme.danger : Theme.text-dim;
                size: 15px;
            }
        }
        Text {
            text: root.label;
            color: !root.enabled ? Theme.idle : root.danger ? Theme.warn : Theme.text;
            font-size: Theme.fs-body;
            font-family: Theme.font;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.shortcut;
            color: Theme.idle;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.closes) { TorrentList.close-menu(); }
            root.chosen();
        }
    }
}

component Separator inherits Rectangle {
    height: 7px;
    // Inset to the same margin the highlight uses, so the line stops where the
    // rounded pill above it stops instead of running into the card's corner.
    Rectangle {
        x: 12px;
        width: parent.width - 24px;
        y: 3px;
        height: 1px;
        background: Theme.border;
    }
}

/// The scrim and the card. Everything that floats sits on one of these.
component MenuSurface inherits Rectangle {
    in property <length> at-x;
    in property <length> at-y;
    in property <length> card-width: 232px;
    callback dismissed;
    background: transparent;

    // Catches the click that dismisses it. Covering the window is what makes
    // "click anywhere else" work without every other control knowing about it.
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.dismissed(); }
        }
    }

    Rectangle {
        width: root.card-width;
        height: body.preferred-height + 10px;
        // Clamped so a right-click near an edge does not open the menu off it.
        x: min(root.at-x, parent.width - self.width - 4px);
        y: min(root.at-y, parent.height - self.height - 4px);
        // The layer a flyout floats on, which is not the layer the bars are.
        background: Theme.card;
        border-radius: Theme.radius-float;
        // A hairline *and* a shadow, which is the one place this app draws a
        // line and means it. Windows 11 puts a stroke on every flyout for a
        // reason a shadow cannot cover: a light menu over light content has
        // nothing else to say where it ends.
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #0000006b;

        body := VerticalLayout {
            padding-top: 5px;
            padding-bottom: 5px;
            @children
        }
    }
}

export component ContextMenu inherits MenuSurface {
    at-x: TorrentList.menu-x;
    at-y: TorrentList.menu-y;
    dismissed => { TorrentList.close-menu(); }

    Item {
        label: TorrentList.selection-running ? @tr("Pause") : @tr("Start");
        glyph: TorrentList.selection-running ? Lucide.pause : Lucide.play;
        shortcut: @tr("Space");
        chosen => {
            if (TorrentList.selection-running) {
                TorrentList.pause-selected();
            } else {
                TorrentList.start-selected();
            }
        }
    }
    Separator { }
    Item {
        label: @tr("Open folder");
        glyph: Lucide.folder-open;
        chosen => { TorrentList.open-folder(); }
    }
    Item {
        label: @tr("Copy magnet link");
        glyph: Lucide.copy;
        chosen => { TorrentList.copy-magnet(); }
    }
    Item {
        label: @tr("Force recheck");
        glyph: Lucide.loader;
        chosen => { TorrentList.recheck-selected(); }
    }
    Separator { }
    Item {
        label: @tr("Remove…");
        glyph: Lucide.trash;
        shortcut: @tr("Del");
        danger: true;
        chosen => { TorrentList.remove-selected(); }
    }
}

/// Which columns the table draws, on a right-click in its header.
///
/// It stays open while you tick things: hiding four columns is one gesture, not
/// four. The name is listed and disabled rather than left out — showing seven of
/// eight columns would raise the question of where the eighth went, and the
/// answer is that it is the row's identity and never optional.
/// The right-click menu on one file of a torrent.
///
/// What qBittorrent offers here is Open, Open containing folder, and a
/// priority with four levels. Three of those levels do not exist in this
/// engine: librqbit knows whether a file is wanted and whether one file is
/// being fetched ahead of the rest, and nothing between. Offering "High" and
/// "Maximum" as separate rows would be two controls that do the same thing,
/// which is worse than a shorter menu.
///
/// So the three states it really has, as three rows that read as a choice.
export component FileMenu inherits MenuSurface {
    property <FileEntry> file: DetailState.files[DetailState.file-menu-index];
    at-x: DetailState.file-menu-x;
    at-y: DetailState.file-menu-y;
    dismissed => { DetailState.close-file-menu(); }

    // First, and above Open, because for a film it is the better answer even
    // when the file has arrived: it plays without waiting for anything.
    if root.file.playable: Item {
        label: @tr("Play now");
        glyph: Lucide.play;
        chosen => { DetailState.play-file(DetailState.file-menu-index); }
    }
    Item {
        label: @tr("Open");
        glyph: Lucide.file;
        // A file that is still coming down opens as whatever has arrived of
        // it, which for video is a few seconds and a codec error. Playing it
        // is the row above, and that one works either way.
        enabled: root.file.complete;
        chosen => { DetailState.open-file(DetailState.file-menu-index); }
    }
    Item {
        label: @tr("Open containing folder");
        glyph: Lucide.folder-open;
        chosen => { DetailState.reveal-file(DetailState.file-menu-index); }
    }
    Separator { }
    Item {
        label: @tr("Do not download");
        glyph: Lucide.x;
        enabled: root.file.wanted;
        chosen => { DetailState.toggle-file(DetailState.file-menu-index); }
    }
    Item {
        label: @tr("Download");
        glyph: Lucide.check;
        enabled: !root.file.wanted;
        chosen => { DetailState.toggle-file(DetailState.file-menu-index); }
    }
    Item {
        label: root.file.first ? @tr("Stop fetching this one first") : @tr("Fetch this one first");
        glyph: Lucide.arrow-up-to-line;
        // Nothing to bring forward on a file that has arrived, or one that is
        // not coming at all.
        enabled: root.file.wanted && !root.file.complete;
        chosen => { DetailState.toggle-first(DetailState.file-menu-index); }
    }
}

export component ColumnsMenu inherits MenuSurface {
    at-x: TorrentList.columns-x;
    at-y: TorrentList.columns-y;
    card-width: 178px;
    dismissed => { TorrentList.close-columns(); }

    for title[i] in TorrentList.col-title: Item {
        label: title;
        glyph: TorrentList.col-visible[i] ? Lucide.check : "";
        enabled: i > 0;
        closes: false;
        chosen => { TorrentList.toggle-column(i); }
    }
}
