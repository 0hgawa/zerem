// The add dialog.
//
// The two decisions that matter — where it goes, and what comes down — get the
// room they deserve instead of a cramped tree with the destination hidden behind
// it. Wide, one file per line, the destination on top where it is read first.

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AddState, PendingFileEntry } from "../state.slint";
import { Icon, Lucide } from "icons.slint";
import { Button, ButtonKind } from "button.slint";
import { Modal, Tick } from "common.slint";

component FileLine inherits Rectangle {
    in property <PendingFileEntry> entry;
    in property <int> index;
    height: 26px;
    background: ta.has-hover ? Theme.hover : mod(index, 2) == 1 ? Theme.row-alt : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Tick { on: entry.wanted; }
        }
        Text {
            text: entry.path;
            // An unticked file dims rather than disappears: it is still there,
            // it is just not coming down.
            color: entry.wanted ? Theme.text : Theme.idle;
            font-size: Theme.fs-body;
            font-family: Theme.font;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: entry.size;
            color: Theme.text-dim;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            vertical-alignment: center;
            width: 84px;
            horizontal-alignment: right;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { AddState.toggle-file(root.index); }
    }
}

export component AddDialog inherits Modal {
    card-width: 660px;
    card-height: 520px;
    dismissed => { AddState.cancel(); }

        VerticalLayout {
            padding: 20px;
            spacing: 14px;

            Text {
                text: AddState.fetching ? @tr("Reading torrent…") : @tr("Add torrent");
                color: Theme.text;
                font-size: Theme.fs-title;
                font-family: Theme.font;
                font-weight: 600;
            }

            Text {
                text: AddState.name;
                color: Theme.text-dim;
                font-size: Theme.fs-body;
                font-family: Theme.font;
                overflow: elide;
            }

            // The destination sits above the file list rather than behind it.
            // It is the decision people get wrong, and burying it is why.
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    width: 66px;
                    Text {
                        text: @tr("Save to");
                        color: Theme.text-dim;
                        font-size: Theme.fs-body;
                        font-family: Theme.font;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: AddState.destination;
                        color: Theme.text;
                        font-size: Theme.fs-body;
                        font-family: Theme.font;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        label: @tr("Change");
                        glyph: Lucide.folder-open;
                        clicked => { AddState.change-destination(); }
                    }
                }
            }

            // A shelf is made by naming one here, and where this torrent goes
            // becomes what that name means. Typing a name the app already knows
            // moves the destination to that shelf's folder — which is the whole
            // feature: nobody navigates to the series folder twice.
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    width: 66px;
                    Text {
                        text: @tr("Category");
                        color: Theme.text-dim;
                        font-size: Theme.fs-body;
                        font-family: Theme.font;
                    }
                }
                Rectangle {
                    height: 32px;
                    border-radius: Theme.radius;
                    background: shelf-input.has-focus ? Theme.surface-hi : Theme.hover;
                    animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

                    accessible-role: text-input;
                    accessible-label: @tr("Category");
                    accessible-value: AddState.category;

                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        shelf-input := TextInput {
                            text <=> AddState.category;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-family: Theme.font;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { AddState.category-typed(self.text); }
                        }
                    }

                    // Empty is a real answer, so it is spelled out rather than
                    // left as a blank nobody knows is optional.
                    if AddState.category == "": Text {
                        x: 9px;
                        text: @tr("None");
                        color: Theme.idle;
                        font-size: Theme.fs-body;
                        font-family: Theme.font;
                        vertical-alignment: center;
                    }
                }
            }

            // Directly under the folder it is about, with the Change button that
            // fixes it still on screen above. The Add button stays live on
            // purpose: the volume may be freed before the download gets there,
            // and files already on disk from a previous run are not counted —
            // refusing on an estimate is worse than saying what it is.
            if AddState.has-folder: HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    width: 66px;
                    Text {
                        text: @tr("Folder");
                        color: Theme.text-dim;
                        font-size: Theme.fs-body;
                        font-family: Theme.font;
                    }
                }
                Rectangle {
                    height: 32px;
                    border-radius: Theme.radius;
                    background: name-input.has-focus ? Theme.surface-hi : Theme.hover;
                    animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

                    accessible-role: text-input;
                    accessible-label: @tr("Folder");
                    accessible-value: AddState.folder;

                    HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        name-input := TextInput {
                            text <=> AddState.folder;
                            color: Theme.text;
                            font-size: Theme.fs-body;
                            font-family: Theme.font;
                            vertical-alignment: center;
                            single-line: true;
                        }
                    }
                }
            }

            if AddState.shortfall != "": HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    width: 66px;
                    Icon { glyph: Lucide.triangle-alert; tint: Theme.warn; size: 15px; }
                }
                Text {
                    text: AddState.shortfall;
                    color: Theme.warn;
                    font-size: Theme.fs-body;
                    font-family: Theme.font;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if AddState.error != "": Text {
                text: AddState.error;
                color: Theme.danger;
                font-size: Theme.fs-body;
                font-family: Theme.font;
                wrap: word-wrap;
            }

            if AddState.fetching: Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: @tr("Fetching the file list from the swarm…");
                        color: Theme.text-dim;
                        font-size: Theme.fs-body;
                        font-family: Theme.font;
                        horizontal-alignment: center;
                    }
                    // Said plainly, because this is the one wait in the app that
                    // can genuinely take a while and looks like a hang otherwise.
                    Text {
                        text: @tr("A magnet link carries no file list — it has to be asked for.");
                        color: Theme.idle;
                        font-size: Theme.fs-label;
                        font-family: Theme.font;
                        horizontal-alignment: center;
                    }
                }
            }

            if !AddState.fetching && AddState.files.length > 0: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: AddState.summary;
                    color: Theme.text-dim;
                    font-size: Theme.fs-label;
                    font-family: Theme.font;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button { label: @tr("All"); kind: ButtonKind.text; clicked => { AddState.set-all(true); } }
                Button { label: @tr("None"); kind: ButtonKind.text; clicked => { AddState.set-all(false); } }
            }

            if !AddState.fetching && AddState.files.length > 0: Rectangle {
                vertical-stretch: 1;
                border-radius: Theme.radius;
                // A filled well rather than an outlined box: Fluent separates
                // by layer and not by stroke, and a rule drawn around a list
                // that already has its own rows is a line drawing a line.
                //
                // `surface-hi` and not `bg`: the card behind it is `surface`,
                // and a well the same colour as the paper it sits on is not a
                // well at all — which is the mistake the whole palette had.
                background: Theme.surface-hi;
                clip: true;
                ListView {
                    for f[i] in AddState.files: FileLine { entry: f; index: i; }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button { label: @tr("Cancel"); kind: ButtonKind.text; clicked => { AddState.cancel(); } }
                Button {
                    label: @tr("Add");
                    glyph: Lucide.plus;
                    kind: ButtonKind.primary;
                    enabled: AddState.can-add;
                    clicked => { AddState.confirm(); }
                }
            }
        }
}
