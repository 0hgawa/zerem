// The panel beside the table: what is inside the selected torrent.
//
// Beside and not beneath. A panel under the table costs rows — the one thing
// the window is for — while a panel at the side costs columns, of which the
// last few are the least urgent. It is also what M3 asks for: bottom sheets are
// the mobile pattern, side sheets the desktop one.
//
// The room it buys is vertical, so every line here is two lines: a path or an
// address, and its numbers underneath. That reads better than a four-column
// table ever did in 1180 — but it needs the width to do it, which is why the
// left edge drags and the number it lands on is remembered.
//
// Opened by clicking a row, the way a mail client opens a message. The list is
// still the app; this is what the click was always asking for.

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { DetailState, FileEntry, PeerEntry } from "../state.slint";
import { Icon, Lucide } from "icons.slint";
import { Button, ButtonKind, IconButton } from "button.slint";
import { EmptyState, Tick } from "common.slint";

component Tab inherits Rectangle {
    in property <string> label;
    in property <string> id;
    in property <string> glyph;
    in property <string> count;
    property <bool> active: DetailState.tab == id;

    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.active;
    accessible-action-default => { DetailState.pick-tab(root.id); }

    height: 26px;
    border-radius: Theme.radius;
    background: active ? Theme.selected : ta.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        spacing: 7px;
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                tint: active ? Theme.accent : Theme.text-dim;
                size: 14px;
            }
        }
        Text {
            text: root.label;
            color: active ? Theme.accent : Theme.text-dim;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.count;
            color: Theme.text-dim;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { DetailState.pick-tab(root.id); }
    }
}

component DetailCell inherits Text {
    color: Theme.text-dim;
    font-size: Theme.fs-label;
    font-family: Theme.font;
    vertical-alignment: center;
    overflow: elide;
}

// Two lines: what the file is, then how far along it is. The tick on the left
// says whether it is coming down at all, and clicking anywhere on the line
// changes that — a 16 px square is a small thing to ask someone to hit fifty
// times in a row.
//
// A finished file shows its size and a tick — no bar, no "100%". The same rule
// the main table follows, for the same reason: most of a list is finished, and
// a full bar on every line of it is decoration.
component FileLine inherits Rectangle {
    in property <FileEntry> entry;
    in property <int> index;
    height: 42px;

    // A checkbox, because that is what it is: the whole line toggles whether
    // the file is being fetched. The path is the label; the tick is the state.
    accessible-role: checkbox;
    accessible-label: root.entry.path;
    accessible-checkable: true;
    accessible-checked: root.entry.wanted;
    accessible-description: root.entry.first ? @tr("Being fetched before the others")
        : root.entry.complete ? @tr("Finished")
        : root.entry.pct;
    accessible-action-default => { DetailState.toggle-file(root.index); }
    background: ta.has-hover ? Theme.hover : mod(index, 2) == 1 ? Theme.row-alt : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Tick { on: entry.wanted; }
        }

        // The desktop's own icon for this kind of file. Whatever the user
        // installed to open it is what they will recognise, and a glyph drawn
        // here would be a second opinion about something already answered.
        VerticalLayout {
            alignment: center;
            Image {
                source: entry.icon;
                width: 16px;
                height: 16px;
                image-fit: contain;
                // A file nobody asked for fades with its name.
                opacity: entry.wanted ? 1.0 : 0.45;
            }
        }

        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;

            DetailCell {
                text: entry.path;
                font-size: Theme.fs-body;
                // A file that is not coming down dims rather than disappears:
                // it is still in the torrent, it is just not being fetched. A
                // finished one stops competing with the ones still moving.
                color: !entry.wanted ? Theme.idle : entry.complete ? Theme.text-dim : Theme.text;
            }

            HorizontalLayout {
                spacing: 8px;
                DetailCell { text: entry.size; }
                // Nothing to say about the progress of a file nobody asked for.
                if !entry.wanted: DetailCell {
                    text: @tr("not downloading");
                    color: Theme.idle;
                    horizontal-stretch: 1;
                }
                if entry.wanted && entry.complete: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        alignment: start;
                        Icon { glyph: Lucide.check; tint: Theme.seeding; size: 12px; }
                    }
                }
                if entry.wanted && !entry.complete: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.track;
                        Rectangle {
                            x: 0;
                            width: parent.width * entry.progress;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.accent;
                        }
                    }
                }
                if entry.wanted && !entry.complete: DetailCell {
                    text: entry.pct;
                    horizontal-alignment: right;
                }
            }
        }
    }

    // Hover only. It is what lifts the row and brings the pin out, and it must
    // not also be the switch.
    ta := TouchArea { }

    // The gutter the tick sits in — 38 px wide and the full height of the row,
    // which is still more than twice the square itself.
    //
    // It used to be the whole line, on the reasoning that a 16 px box is a
    // small thing to ask somebody to hit fifty times in a row. That was right
    // about the target and wrong about the line: once the line grew a second
    // action, a click on the path, the size or the progress bar silently
    // switched the file off.
    //
    // Declared after the hover area so it takes its own clicks, the same order
    // the pin below relies on.
    TouchArea {
        x: 0;
        width: 38px;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { DetailState.toggle-file(root.index); }
    }

    // Declared after the line's own touch area so it wins its own clicks — the
    // same trick the table's per-row button uses.
    //
    // Hidden until the line is under the cursor, and only on a file that is
    // still coming down: a second control on every line of a four-thousand file
    // list is four thousand more things to look past. A pin that is *set* stays
    // visible, because it is the reason the rest of the torrent stopped.
    Rectangle {
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: Theme.radius;
        // Faded rather than conditional, and not for the animation: an element
        // cannot be referred to from the condition that creates it, and this one
        // has to stay up while the cursor is on it — the pin sits over the
        // line's own touch area and takes the hover away from it.
        opacity: (root.entry.complete || !root.entry.wanted) ? 0
            : (root.entry.first || ta.has-hover || pin.has-hover) ? 1
            : 0;
        animate opacity { duration: Theme.quick; easing: Theme.ease-standard(); }
        background: root.entry.first ? Theme.accent
            : pin.has-hover ? Theme.surface-hi
            : transparent;
        animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

        Icon {
            glyph: Lucide.arrow-up-to-line;
            tint: root.entry.first ? #ffffff : Theme.text-dim;
            size: 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        accessible-role: button;
        accessible-label: root.entry.first ? @tr("Stop fetching this one first")
            : @tr("Fetch this one before the others");
        accessible-enabled: !root.entry.complete && root.entry.wanted;
        accessible-action-default => { DetailState.toggle-first(root.index); }

        pin := TouchArea {
            // Off on a line that has no pin to offer, so an invisible control
            // cannot be clicked and the hover falls through to the line.
            enabled: !root.entry.complete && root.entry.wanted;
            mouse-cursor: pointer;
            clicked => { DetailState.toggle-first(root.index); }
        }
    }
}

// Two lines: who it is, then what it is doing.
component PeerLine inherits Rectangle {
    in property <PeerEntry> entry;
    in property <int> index;
    height: 42px;
    background: mod(index, 2) == 1 ? Theme.row-alt : transparent;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 3px;

        HorizontalLayout {
            spacing: 8px;
            DetailCell {
                text: entry.addr;
                font-size: Theme.fs-body;
                color: Theme.text;
            }
            DetailCell { text: entry.client; horizontal-stretch: 1; }
            // The one place uTP is visible at all, which is why it keeps its own
            // slot and takes the accent when it is what the peer is using.
            DetailCell {
                text: entry.transport;
                color: entry.transport == "uTP" ? Theme.accent : Theme.text-dim;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            DetailCell { text: entry.state; horizontal-stretch: 1; }
            Icon { glyph: Lucide.arrow-down; tint: Theme.accent; size: 11px; }
            DetailCell { text: entry.down; }
            Icon { glyph: Lucide.arrow-up; tint: Theme.seeding; size: 11px; }
            DetailCell { text: entry.up; }
        }
    }
}

export component DetailDrawer inherits Rectangle {
    /// What the panel measures when it is all the way open.
    ///
    /// The root's own width is the animated one, and the sheet inside is laid
    /// out once at this size and slid past the clip. Animating the layout width
    /// instead would re-elide every path and every address on every frame, and
    /// text jumping between two elisions is not motion, it is a glitch.
    in property <length> full-width;
    background: Theme.surface;
    clip: true;

    sheet := Rectangle {
    width: root.full-width;
    background: Theme.surface;


    // The grip, on the edge the drawer grows from. Same eight pixels and the
    // same cursor the column handles use, because it is the same gesture — and
    // declared before the content so a control inside the panel still wins its
    // own clicks. Inside the sheet rather than over the seam: a touch area
    // hanging outside a clipping parent is not reliably hit.
    TouchArea {
        x: 0;
        width: 8px;
        height: parent.height;
        mouse-cursor: col-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { DetailState.resize-begin(); }
        }
        moved => {
            if (self.pressed) { DetailState.resize-move(self.mouse-x - self.pressed-x); }
        }
    }

    VerticalLayout {
        spacing: 0px;

        // The title gets a line of its own, which the drawer under the table
        // never had room for: it used to be dim, right-aligned and elided into
        // whatever the tabs left over.
        Rectangle {
            height: 38px;
            HorizontalLayout {
                padding-left: 13px;
                padding-right: 8px;
                spacing: 6px;
                Text {
                    text: DetailState.title;
                    color: Theme.text;
                    font-size: Theme.fs-title;
                    font-family: Theme.font;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        glyph: Lucide.x;
                        label: @tr("Close the details panel");
                        clicked => { DetailState.close(); }
                    }
                }
            }
        }

        // A failure gets the top of the panel, above the tabs, because it is
        // the answer to the question that brought someone here. The message
        // wraps rather than elides — the state column already tried eliding it,
        // and that is what this is for.
        //
        // Try again is a real retry, not a hopeful one: starting an errored
        // torrent makes librqbit re-initialise it, hash what is on disk and
        // carry on. Whatever went wrong has to be fixed first, which is why the
        // button says what it does and does not pretend to fix it.
        if DetailState.fault != "": Rectangle {
            background: Theme.danger.with-alpha(0.12);
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: start;
                        Icon { glyph: Lucide.triangle-alert; tint: Theme.danger; size: 15px; }
                    }
                    Text {
                        text: DetailState.fault;
                        color: Theme.danger;
                        font-size: Theme.fs-body;
                        font-family: Theme.font;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        label: @tr("Try again");
                        glyph: Lucide.play;
                        clicked => { DetailState.retry(); }
                    }
                }
            }
        }

        Rectangle {
            height: 34px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 6px;
                spacing: 4px;
                Tab { label: @tr("Files"); id: "files"; glyph: Lucide.file; count: DetailState.files-summary; }
                Tab { label: @tr("Peers"); id: "peers"; glyph: Lucide.users; count: DetailState.peers-summary; }
            }
        }

        if DetailState.tab == "files" && DetailState.files.length == 0:
            EmptyState {
                glyph: Lucide.file;
                title: @tr("No file list yet");
                detail: @tr("A magnet has none until its metadata arrives.");
            }
        // What is actually coming down, above the list rather than inside it.
        // The torrent's own size is not the number the reader wants once
        // something has been left out.
        // The folder above what is inside it, the way a file manager shows one
        // — and the way the client everybody is coming from shows this.
        //
        // The tick is the whole list at once. It only ever goes one way, which
        // is not a gap: a torrent that fetches nothing is refused, so the other
        // direction has no outcome but a refusal. This is the way back from
        // having unticked too much; choosing a handful out of thousands is what
        // the add dialog is for.
        if DetailState.tab == "files" && DetailState.files.length > 0: Rectangle {
            height: 34px;
            background: head.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

            accessible-role: checkbox;
            accessible-label: DetailState.files-folder;
            accessible-checkable: true;
            accessible-checked: !DetailState.files-partial;
            accessible-action-default => { DetailState.restore-all-files(); }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    // Filled when everything is coming down, hollow the moment
                    // anything is not — the mixed state a file manager shows as
                    // a dash, said here by the tick simply not being on.
                    Tick { on: !DetailState.files-partial; }
                }
                VerticalLayout {
                    alignment: center;
                    Icon { glyph: Lucide.folder-open; tint: Theme.warn; size: 16px; }
                }
                Text {
                    text: DetailState.files-folder;
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    font-family: Theme.font;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    DetailCell { text: DetailState.files-choice; }
                }
            }

            head := TouchArea {
                width: 38px;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { DetailState.restore-all-files(); }
            }
        }


        if DetailState.tab == "files" && DetailState.files.length > 0: ListView {
            for f[i] in DetailState.files: FileLine { entry: f; index: i; }
        }

        if DetailState.tab == "peers" && DetailState.peers.length == 0:
            EmptyState {
                glyph: Lucide.users;
                title: @tr("No peers connected");
                detail: @tr("A paused torrent has none.");
            }
        if DetailState.tab == "peers" && DetailState.peers.length > 0: ListView {
            for p[i] in DetailState.peers: PeerLine { entry: p; index: i; }
        }
    }
    }
}
