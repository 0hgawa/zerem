// The panel beside the table: what is inside the selected torrent.
//
// Beside and not beneath. A panel under the table costs rows — the one thing
// the window is for — while a panel at the side costs columns, of which the
// last few are the least urgent. It is also what M3 asks for: bottom sheets are
// the mobile pattern, side sheets the desktop one.
//
// The room it buys is vertical, so every line here is two lines: a path or an
// address, and its numbers underneath. That reads better than a four-column
// table ever did in 1180 — but it needs the width to do it, which is why the
// left edge drags and the number it lands on is remembered.
//
// Opened by clicking a row, the way a mail client opens a message. The list is
// still the app; this is what the click was always asking for.

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { DetailState, FileEntry, PeerEntry } from "../state.slint";
import { Icon, Lucide } from "icons.slint";
import { Button, ButtonKind, IconButton } from "button.slint";
import { EmptyState, Stat, Tick } from "common.slint";

component Tab inherits Rectangle {
    in property <string> label;
    in property <string> id;
    in property <string> glyph;
    in property <string> count;
    property <bool> active: DetailState.tab == id;

    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.active;
    accessible-action-default => { DetailState.pick-tab(root.id); }

    // A filled pill was here, and at the width the panel has now it stretched
    // into a slab that was the loudest thing on screen — a tab strip announcing
    // itself over the file list it is a label for. Windows draws this as a
    // short bar under the chosen tab and nothing else, which is the quietest
    // way to say the same thing.
    height: 30px;
    background: ta.has-hover ? Theme.hover : transparent;
    border-radius: Theme.radius;

    if root.active: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        x: 10px;
        width: parent.width - 20px;
        border-radius: 1px;
        background: Theme.accent-fill;
    }

    HorizontalLayout {
        spacing: 7px;
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                tint: active ? Theme.accent : Theme.text-dim;
                size: 14px;
            }
        }
        Text {
            text: root.label;
            color: active ? Theme.accent : Theme.text-dim;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            font-weight: Theme.semibold;
            vertical-alignment: center;
        }
        Text {
            text: root.count;
            color: Theme.text-dim;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { DetailState.pick-tab(root.id); }
    }
}

component DetailCell inherits Text {
    color: Theme.text-dim;
    font-size: Theme.fs-label;
    font-family: Theme.font;
    vertical-alignment: center;
    overflow: elide;
}

// Two lines: what the file is, then how far along it is. The tick on the left
// says whether it is coming down at all, and clicking anywhere on the line
// changes that — a 16 px square is a small thing to ask someone to hit fifty
// times in a row.
//
// A finished file shows its size and a tick — no bar, no "100%". The same rule
// the main table follows, for the same reason: most of a list is finished, and
// a full bar on every line of it is decoration.
component FileLine inherits Rectangle {
    in property <FileEntry> entry;
    in property <int> index;
    height: 28px;

    // A checkbox, because that is what it is: the whole line toggles whether
    // the file is being fetched. The path is the label; the tick is the state.
    accessible-role: checkbox;
    accessible-label: root.entry.path;
    accessible-checkable: true;
    accessible-checked: root.entry.wanted;
    accessible-description: root.entry.first ? @tr("Being fetched before the others")
        : root.entry.complete ? @tr("Finished")
        : root.entry.pct;
    accessible-action-default => { DetailState.toggle-file(root.index); }
    background: mod(index, 2) == 1 ? Theme.row-alt : transparent;

    // The same inset pill the table draws, for the same reason: a highlight
    // that runs to the edges of a panel is what makes a list look like Windows
    // 7. Behind the layout, so every cell still draws over it.
    Rectangle {
        x: 4px;
        y: 1px;
        width: parent.width - 8px;
        height: parent.height - 2px;
        border-radius: Theme.radius-row;
        background: ta.has-hover ? Theme.hover : transparent;
        animate background { duration: Theme.quick; easing: Theme.ease-standard(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Tick { on: entry.wanted; }
        }

        // The desktop's own icon for this kind of file. Whatever the user
        // installed to open it is what they will recognise, and a glyph drawn
        // here would be a second opinion about something already answered.
        VerticalLayout {
            alignment: center;
            Image {
                source: entry.icon;
                width: 16px;
                height: 16px;
                image-fit: contain;
                // A file nobody asked for fades with its name.
                opacity: entry.wanted ? 1.0 : 0.45;
            }
        }

        // One line, not two. The size used to sit on a second row under the
        // name, which doubled the row height, pushed the list to half as many
        // files on screen, and put a number nowhere near the right edge that
        // every other list in this app puts numbers at. It also left the ticks
        // as a tall column of blue with nothing beside them, which is why the
        // panel read as a checkbox list rather than a file list.
        // Two halves, dimmed apart. `Featurettes\Trailer.mkv` printed whole put
        // the folder in the same weight as the name, and the name is the whole
        // of what anybody is looking for — the folder only says which of two
        // files called `01.mkv` this one is. Rust splits it; see
        // `zerem_core::split_path`, and the rule that the window formats
        // nothing.
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            if entry.folder != "": DetailCell {
                text: entry.folder;
                font-size: Theme.fs-body;
                color: Theme.idle;
            }
            DetailCell {
                text: entry.name;
                font-size: Theme.fs-body;
                horizontal-stretch: 1;
                // A file that is not coming down dims rather than disappears:
                // it is still in the torrent, it is just not being fetched. A
                // finished one stops competing with the ones still moving.
                color: !entry.wanted ? Theme.idle : entry.complete ? Theme.text-dim : Theme.text;
            }
        }

        // What it is doing, in the slot before the size, so the sizes stay in
        // one column whatever each file happens to be up to.
        if !entry.wanted: DetailCell {
            text: @tr("not downloading");
            color: Theme.idle;
        }
        if entry.wanted && entry.complete: VerticalLayout {
            alignment: center;
            Icon { glyph: Lucide.check; tint: Theme.seeding; size: 12px; }
        }
        if entry.wanted && !entry.complete: VerticalLayout {
            alignment: center;
            width: 54px;
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.track;
                Rectangle {
                    x: 0;
                    width: parent.width * entry.progress;
                    height: parent.height;
                    border-radius: parent.border-radius;
                    background: Theme.accent-fill;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            width: 68px;
            DetailCell {
                text: entry.size;
                horizontal-alignment: right;
            }
        }
    }

    // Hover only. It is what lifts the row and brings the pin out, and it must
    // not also be the switch.
    //
    // It does take the right button, though. The menu wants the whole line as
    // its target — a right-click anywhere on a file is about that file — and
    // this is the one area that covers all of it.
    ta := TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                DetailState.open-file-menu(root.index, self.absolute-position.x + self.mouse-x,
                                           self.absolute-position.y + self.mouse-y);
            }
        }
        // The same thing a double click does to a file everywhere else, and
        // the same action the menu's first row offers.
        double-clicked => { DetailState.open-file(root.index); }
    }

    // The gutter the tick sits in — 38 px wide and the full height of the row,
    // which is still more than twice the square itself.
    //
    // It used to be the whole line, on the reasoning that a 16 px box is a
    // small thing to ask somebody to hit fifty times in a row. That was right
    // about the target and wrong about the line: once the line grew a second
    // action, a click on the path, the size or the progress bar silently
    // switched the file off.
    //
    // Declared after the hover area so it takes its own clicks, the same order
    // the pin below relies on.
    TouchArea {
        x: 0;
        width: 38px;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { DetailState.toggle-file(root.index); }
    }

    // Declared after the line's own touch area so it wins its own clicks — the
    // same trick the table's per-row button uses.
    //
    // Hidden until the line is under the cursor, and only on a file that is
    // still coming down: a second control on every line of a four-thousand file
    // list is four thousand more things to look past. A pin that is *set* stays
    // visible, because it is the reason the rest of the torrent stopped.
    Rectangle {
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: Theme.radius;
        // Faded rather than conditional, and not for the animation: an element
        // cannot be referred to from the condition that creates it, and this one
        // has to stay up while the cursor is on it — the pin sits over the
        // line's own touch area and takes the hover away from it.
        opacity: (root.entry.complete || !root.entry.wanted) ? 0
            : (root.entry.first || ta.has-hover || pin.has-hover) ? 1
            : 0;
        animate opacity { duration: Theme.quick; easing: Theme.ease-standard(); }
        background: root.entry.first ? Theme.accent-fill
            : pin.has-hover ? Theme.surface-hi
            : transparent;
        animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

        Icon {
            glyph: Lucide.arrow-up-to-line;
            tint: root.entry.first ? #ffffff : Theme.text-dim;
            size: 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        accessible-role: button;
        accessible-label: root.entry.first ? @tr("Stop fetching this one first")
            : @tr("Fetch this one before the others");
        accessible-enabled: !root.entry.complete && root.entry.wanted;
        accessible-action-default => { DetailState.toggle-first(root.index); }

        pin := TouchArea {
            // Off on a line that has no pin to offer, so an invisible control
            // cannot be clicked and the hover falls through to the line.
            enabled: !root.entry.complete && root.entry.wanted;
            mouse-cursor: pointer;
            clicked => { DetailState.toggle-first(root.index); }
        }
    }
}

// Two lines: who it is, then what it is doing.
component PeerLine inherits Rectangle {
    in property <PeerEntry> entry;
    in property <int> index;
    height: 42px;
    background: mod(index, 2) == 1 ? Theme.row-alt : transparent;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 3px;

        HorizontalLayout {
            spacing: 8px;
            // Left of the address, where it is read first and answers "who is
            // this?" before the number has to be. A fixed slot whether or not
            // there is a flag in it, so the addresses stay in one column
            // instead of stepping in and out as peers come and go.
            VerticalLayout {
                alignment: center;
                width: 20px;
                Image {
                    source: entry.flag;
                    width: 20px;
                    height: 15px;
                    image-fit: contain;
                }
            }
            DetailCell {
                text: entry.addr;
                font-size: Theme.fs-body;
                color: Theme.text;
            }
            DetailCell { text: entry.client; horizontal-stretch: 1; }
            // The one place uTP is visible at all, which is why it keeps its own
            // slot and takes the accent when it is what the peer is using.
            DetailCell {
                text: entry.transport;
                color: entry.transport == "uTP" ? Theme.accent : Theme.text-dim;
                horizontal-alignment: right;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            DetailCell { text: entry.state; horizontal-stretch: 1; }
            Icon { glyph: Lucide.arrow-down; tint: Theme.accent; size: 11px; }
            DetailCell { text: entry.down; }
            Icon { glyph: Lucide.arrow-up; tint: Theme.seeding; size: 11px; }
            DetailCell { text: entry.up; }
        }
    }
}

export component DetailDrawer inherits Rectangle {
    /// What the panel measures when it is all the way open.
    ///
    /// The root's own width is the animated one, and the sheet inside is laid
    /// out once at this size and slid past the clip. Animating the layout width
    /// instead would re-elide every path and every address on every frame, and
    /// text jumping between two elisions is not motion, it is a glitch.
    in property <length> full-width;
    background: Theme.surface;
    // A card of its own, like everything else in the window. The clip that
    // makes the slide work rounds the corners too, which is why the radius
    // goes here rather than on the sheet inside.
    border-radius: Theme.radius-float;
    clip: true;

    sheet := Rectangle {
        width: root.full-width;
        // And the full height of the panel. Without this it was as tall as
        // whatever happened to be inside it, so folding the file list away left
        // the panel's content sitting in a short strip at the top with the
        // background below it — the panel looked like it had shrunk because the
        // only part of it with anything in it had.
        height: parent.height;
        background: Theme.surface;


    // The grip, on the edge the drawer grows from. Same eight pixels and the
    // same cursor the column handles use, because it is the same gesture — and
    // declared before the content so a control inside the panel still wins its
    // own clicks. Inside the sheet rather than over the seam: a touch area
    // hanging outside a clipping parent is not reliably hit.
    TouchArea {
        x: 0;
        width: 8px;
        height: parent.height;
        mouse-cursor: col-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { DetailState.resize-begin(); }
        }
        moved => {
            if (self.pressed) { DetailState.resize-move(self.mouse-x - self.pressed-x); }
        }
    }

    VerticalLayout {
        spacing: 0px;

        // The title gets a line of its own, which the drawer under the table
        // never had room for: it used to be dim, right-aligned and elided into
        // whatever the tabs left over.
        Rectangle {
            height: 38px;
            HorizontalLayout {
                padding-left: 13px;
                padding-right: 8px;
                spacing: 6px;
                Text {
                    text: DetailState.title;
                    color: Theme.text;
                    font-size: Theme.fs-title;
                    font-family: Theme.font;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        glyph: Lucide.x;
                        label: @tr("Close the details panel");
                        clicked => { DetailState.close(); }
                    }
                }
            }
        }


        // How the torrent is doing, which the panel never said.
        //
        // You could open the insides of a torrent and not tell whether it was
        // moving — the name, then straight into a file list. This is the first
        // question anybody has when they click a row, so it is the first thing
        // the panel answers, and everything in it comes from the same row the
        // table draws so the two cannot disagree.
        Rectangle {
            height: 92px;
            VerticalLayout {
                padding-left: 13px;
                padding-right: 13px;
                padding-bottom: 10px;
                spacing: 8px;

                // The bar first: it is read without being read.
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.track;
                    Rectangle {
                        x: 0;
                        width: parent.width * DetailState.progress;
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: DetailState.kind == 4 ? Theme.danger
                            : DetailState.kind == 2 ? Theme.seeding
                            : DetailState.kind == 3 ? Theme.idle
                            : Theme.accent-fill;
                        animate width { duration: Theme.quick; easing: Theme.ease-standard(); }
                    }
                }

                // Then the sentence: what it is doing, how fast, and how long.
                // One line, because three facts on three lines is a form.
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: DetailState.state;
                        color: DetailState.kind == 4 ? Theme.danger
                            : DetailState.kind == 2 ? Theme.seeding
                            : DetailState.kind == 1 ? Theme.accent
                            : Theme.text-dim;
                        font-size: Theme.fs-label;
                        font-family: Theme.font;
                        font-weight: Theme.semibold;
                        vertical-alignment: center;
                    }
                    Text {
                        text: DetailState.progress-text;
                        color: Theme.text;
                        font-size: Theme.fs-label;
                        font-family: Theme.font;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if DetailState.eta != "": Text {
                        text: DetailState.eta;
                        color: Theme.text-dim;
                        font-size: Theme.fs-label;
                        font-family: Theme.font;
                        vertical-alignment: center;
                    }
                }

                // The four numbers, in the marks the status bar already taught.
                HorizontalLayout {
                    spacing: 14px;
                    Stat {
                        glyph: Lucide.arrow-down;
                        value: DetailState.down;
                        hint: @tr("Download speed");
                        tint: Theme.accent;
                    }
                    Stat {
                        glyph: Lucide.arrow-up;
                        value: DetailState.up;
                        hint: @tr("Upload speed");
                        tint: Theme.seeding;
                    }
                    Stat {
                        glyph: Lucide.users;
                        value: DetailState.swarm;
                        hint: @tr("Peers");
                        tint: Theme.text-dim;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Stat {
                        glyph: Lucide.zap;
                        value: DetailState.ratio;
                        hint: @tr("Ratio");
                        tint: Theme.text-dim;
                    }
                }
            }
        }

        // And what can be done about it, on the torrent this panel is about —
        // not on the selection, which may be three other rows. Every one of
        // these has another route: the button on the hovered row, the menu,
        // the keyboard. This is the route for somebody who is already looking
        // at the thing.
        Rectangle {
            height: 44px;
            HorizontalLayout {
                padding-left: 13px;
                padding-right: 13px;
                padding-bottom: 10px;
                spacing: 8px;
                alignment: start;

                Button {
                    label: DetailState.running ? @tr("Pause") : @tr("Start");
                    glyph: DetailState.running ? Lucide.pause : Lucide.play;
                    kind: ButtonKind.primary;
                    clicked => { DetailState.toggle-running(); }
                }
                Button {
                    label: @tr("Open folder");
                    glyph: Lucide.folder-open;
                    clicked => { DetailState.open-folder(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    label: @tr("Remove…");
                    glyph: Lucide.trash;
                    kind: ButtonKind.danger;
                    clicked => { DetailState.remove(); }
                }
            }
        }
        // A failure gets the top of the panel, above the tabs, because it is
        // the answer to the question that brought someone here. The message
        // wraps rather than elides — the state column already tried eliding it,
        // and that is what this is for.
        //
        // Try again is a real retry, not a hopeful one: starting an errored
        // torrent makes librqbit re-initialise it, hash what is on disk and
        // carry on. Whatever went wrong has to be fixed first, which is why the
        // button says what it does and does not pretend to fix it.
        if DetailState.fault != "": Rectangle {
            background: Theme.danger.with-alpha(0.12);
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: start;
                        Icon { glyph: Lucide.triangle-alert; tint: Theme.danger; size: 15px; }
                    }
                    Text {
                        text: DetailState.fault;
                        color: Theme.danger;
                        font-size: Theme.fs-body;
                        font-family: Theme.font;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        label: @tr("Try again");
                        glyph: Lucide.play;
                        clicked => { DetailState.retry(); }
                    }
                }
            }
        }

        // Left-aligned and hugging their labels. They used to share the width
        // between them, which made two tabs into two half-panel buttons.
        Rectangle {
            height: 34px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 2px;
                alignment: start;
                Tab { label: @tr("Files"); id: "files"; glyph: Lucide.file; count: DetailState.files-summary; }
                Tab { label: @tr("Peers"); id: "peers"; glyph: Lucide.users; count: DetailState.peers-summary; }
            }
        }

        if DetailState.tab == "files" && DetailState.files.length == 0:
            EmptyState {
                glyph: Lucide.file;
                title: @tr("No file list yet");
                detail: @tr("A magnet has none until its metadata arrives.");
            }
        // What is actually coming down, above the list rather than inside it.
        // The torrent's own size is not the number the reader wants once
        // something has been left out.
        // The folder above what is inside it, the way a file manager shows one
        // — and the way the client everybody is coming from shows this.
        //
        // Three controls in one row, and each is its own target rather than the
        // whole line: the chevron folds the list away, the tick is every file
        // at once, and the name is neither.
        //
        // The tick goes both ways now. It used to only switch everything on,
        // because a torrent fetching nothing was refused — and a control that
        // works in one direction reads as a control that does not work.
        // Fetching nothing is a real answer: keep what is on disk, share it,
        // take no more. The row says so instead of the click being swallowed.
        if DetailState.tab == "files" && DetailState.files.length > 0: Rectangle {
            height: 34px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;

                tickbox := TouchArea {
                    width: 24px;
                    height: parent.height;
                    mouse-cursor: pointer;
                    // Away from everything when anything is off, everything off
                    // when it is all on. Gmail's rule, and every list's.
                    clicked => { DetailState.set-all-files(DetailState.files-partial); }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Tick { on: !DetailState.files-partial; }
                        }
                    }
                }

                // The desktop's own, the same as every file row below it.
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: DetailState.folder-icon;
                        width: 16px;
                        height: 16px;
                        image-fit: contain;
                    }
                }
                Text {
                    text: DetailState.files-folder;
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    font-family: Theme.font;
                    font-weight: Theme.semibold;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    DetailCell { text: DetailState.files-choice; }
                }

                // The fold, at the right-hand end.
                //
                // It was first in the row, on the reasoning that a fold belongs
                // at the leftmost edge of what it folds. True of a tree, and
                // this is not one: it is a header over a flat list, and putting
                // the chevron ahead of the tick pushed that tick a chevron's
                // width to the right of every tick below it. Children sitting
                // to the *left* of their parent is hierarchy read backwards,
                // and it was the first thing anyone noticed about this panel.
                //
                // Indenting the files instead would have squared it, and cost
                // twenty-four pixels of name on every row in a panel where the
                // names already elide. Windows 11 puts an expander's chevron on
                // the right; this row is an expander; so does this.
                fold := TouchArea {
                    width: 24px;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { DetailState.files-collapsed = !DetailState.files-collapsed; }
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 7px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        background: fold.has-hover ? Theme.surface-hi : transparent;
                        animate background { duration: Theme.quick; easing: Theme.ease-standard(); }
                        Icon {
                            glyph: DetailState.files-collapsed ? Lucide.chevron-right : Lucide.chevron-down;
                            tint: Theme.text-dim;
                            size: 14px;
                        }
                    }
                }
            }

            accessible-role: checkbox;
            accessible-label: DetailState.files-folder;
            accessible-checkable: true;
            accessible-checked: !DetailState.files-partial;
            accessible-expandable: true;
            accessible-expanded: !DetailState.files-collapsed;
            accessible-action-default => { DetailState.set-all-files(DetailState.files-partial); }
        }

        // Takes whatever the header and the tabs did not, and scrolls inside
        // it. A four-thousand-file torrent is a scroll, not a taller panel.
        if DetailState.tab == "files" && DetailState.files.length > 0
            && !DetailState.files-collapsed: ListView {
            vertical-stretch: 1;
            for f[i] in DetailState.files: FileLine { entry: f; index: i; }
        }

        // Nothing to show, and something has to hold the height: without it the
        // column has no stretching child and the layout packs everything into
        // the top of the panel.
        if DetailState.tab == "files" && DetailState.files-collapsed: Rectangle {
            vertical-stretch: 1;
        }

        if DetailState.tab == "peers" && DetailState.peers.length == 0:
            EmptyState {
                glyph: Lucide.users;
                title: @tr("No peers connected");
                detail: @tr("A paused torrent has none.");
            }
        if DetailState.tab == "peers" && DetailState.peers.length > 0: ListView {
            vertical-stretch: 1;
            for p[i] in DetailState.peers: PeerLine { entry: p; index: i; }
        }
    }
    }
}
