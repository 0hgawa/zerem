// The small pieces that were inlined in the window until there were enough of
// them to be a file.
//
// Each is used from more than one place, which is the test for extracting: a
// component that exists once is a section of its parent with extra ceremony.

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, Lucide } from "icons.slint";
import { Button, ButtonKind, IconButton } from "button.slint";
import { Hint } from "../state.slint";

/// A number in the status bar, marked by what it counts.
///
/// The mark carries the meaning and the word is gone. Five words strung across
/// the bar were five things to read, and a row of counters is glanced at rather
/// than read — the same reason no toolbar in the app spells its buttons out.
///
/// The word does not vanish, though: it moves to `hint`, which is what a screen
/// reader announces. An icon nobody can hear is not more compact, it is less
/// finished.
export component Stat inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> value;
    in property <string> hint;
    in property <brush> tint: Theme.text;
    spacing: 4px;

    accessible-role: text;
    accessible-label: root.hint;
    accessible-value: root.value;

    VerticalLayout {
        alignment: center;
        Icon { glyph: root.glyph; tint: root.tint; size: 13px; }
    }
    Text {
        text: root.value;
        color: root.tint;
        font-size: Theme.fs-label;
        font-family: Theme.font;
        font-weight: Theme.semibold;
        vertical-alignment: center;
    }
}

/// The mark on its own, without a touch area or a label.
///
/// Used wherever a whole line is the target rather than the box — the file
/// lists in the add dialog and the drawer both work that way, because a 16 px
/// square is a small thing to ask someone to hit fifty times in a row.
export component Tick inherits Rectangle {
    in property <bool> on;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    // One square, always the same. Only the mark comes and goes.
    //
    // It was filled once and transparent once, and the transparent version was
    // wrong for a reason worth keeping: with no edge, the row showed through
    // and a ticked box read as *white*, so ticking a file changed the colour of
    // its square rather than putting a mark in it.
    //
    // Outlined, it can be empty and still be a square. The edge is the seat and
    // the mark is the answer, which is the same rule the fields and the buttons
    // beside it now follow.
    background: transparent;
    border-width: 1px;
    border-color: Theme.stroke;
    if on: Icon {
        glyph: Lucide.check;
        // Ink: near-black on a light theme, near-white on a dark one, so it
        // keeps the same weight against the paper in both.
        tint: Theme.text;
        size: 12px;
        // Heavier than Lucide's own twelfth: at twelve pixels that is a
        // hairline, and this mark is read at a glance down a column.
        weight: 1.0 / 7.0;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

/// A tick box that answers for itself, with a label beside it.
export component Check inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    /// Raised after the flip, for the callers that have to write it somewhere.
    /// A two-way binding on its own changes the box and nothing else.
    callback toggled(bool);
    height: 22px;

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Tick { on: root.checked; }
        }
        if root.label != "": Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.fs-body;
            font-family: Theme.font;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

/// A group of settings rows on a panel of their own.
///
/// What makes a settings screen readable is not the rows, it is the grouping:
/// four cards of three are taken in at a glance where twelve rows in a column
/// have to be read. The panel is a raised surface rather than an outline —
/// Fluent separates by layer, and this app draws no boxes.
export component SettingsCard inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius-float;
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 2px;
        padding-bottom: 2px;
        @children
    }
}

/// The hairline between two rows of a card.
///
/// Inset by the card's own padding so it separates the rows without drawing a
/// line across the panel — the distinction between a divider and a border, and
/// the reason this one is allowed.
export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

/// One setting: what it is on the left, what changes it on the right.
///
/// The name and its explanation stack and take all the room they need; the
/// control sits at the right edge where the eye already is after reading. It
/// replaces a fixed label column that made every row read as a form field, and
/// it is the shape every settings screen on this desktop uses.
export component SettingsRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    min-height: 52px;

    HorizontalLayout {
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 14px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-family: Theme.font;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.text-dim;
                font-size: Theme.fs-label;
                font-family: Theme.font;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

/// The surface anything that floats is drawn on: a menu, the list a dropdown
/// opens, anything that covers the window rather than sitting in it.
///
/// One component because there are two of these and they were drifting: the
/// menu and the dropdown each carried their own copy of the radius, the border
/// and the shadow, and a change to one of them was a change to one of them.
///
/// A single shadow rather than the two Fluent layers on top of each other.
/// Slint gives a rectangle one, and stacking a second means a second rectangle
/// casting a shadow this renderer draws outside its parent -- which is how the
/// tooltip once tore holes in the window under partial redraw. A real edge and
/// one well-judged shadow do the work that two shadows and no edge did not.
export component Flyout inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius-float;
    border-width: 1px;
    // The same edge the outline buttons draw. What it was before was four per
    // cent of black, which over a white card is not an edge at all -- but the
    // answer to that is a real stroke, not a heavier one than anything else in
    // the window wears.
    border-color: Theme.stroke;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.float-shade;
    @children
}

/// The scrim and card every modal shares.
///
/// Extracted because three dialogs had the same forty lines of centring, border
/// radius and click-catching, and the fourth would have had them too.
export component Modal inherits Rectangle {
    in property <length> card-width: 520px;
    in property <length> card-height;
    /// Whether the card wears a close button in its corner.
    ///
    /// Drawn here rather than by whoever fills the card, and that is not a
    /// convenience: a child of this component is placed inside the card but its
    /// `parent` resolves to *this* element, so a corner worked out by a caller
    /// lands in the corner of the window instead — on the scrim, where a dim
    /// glyph is invisible and a click dismisses anyway. Only the thing that
    /// knows where the card is can put something in its corner.
    in property <bool> closable;
    callback dismissed;
    background: #00000080;

    // Catches the click that dismisses. Covering the window is what makes
    // "click anywhere else" work without every other control knowing about it.
    TouchArea {
        clicked => { root.dismissed(); }
    }

    Rectangle {
        width: min(root.card-width, parent.width - 40px);
        height: min(root.card-height, parent.height - 40px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Theme.radius-float;
        // No outline. The scrim already separates it from what is behind.
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000073;

        // Swallows clicks so they never reach the scrim.
        TouchArea { }

        @children

        // Last, so it draws over whatever fills the card, and outside that
        // filling's padding — a close button inset by the content's margin is
        // one somebody has to aim at, where a corner can be hit by throwing
        // the pointer at it.
        if root.closable: IconButton {
            x: parent.width - self.width - 8px;
            y: 8px;
            glyph: Lucide.x;
            label: @tr("Close");
            clicked => { root.dismissed(); }
        }
    }
}

/// Never a bare "no data". The first thing a new user sees says what to do.
export component EmptyState inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <string> detail;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        if root.glyph != "": HorizontalLayout {
            alignment: center;
            Icon { glyph: root.glyph; tint: Theme.idle; size: 40px; }
        }
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 16px;
            font-family: Theme.font;
            horizontal-alignment: center;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: Theme.text-dim;
            font-size: Theme.fs-body;
            font-family: Theme.font;
            horizontal-alignment: center;
        }
        @children
    }
}

/// The filter box.
///
/// Its own component because it owns behaviour and not only a shape: where the
/// focus goes on Ctrl+F, what Escape does, and when the clear button exists at
/// all. The window composes it; it does not reach into the window.
export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    /// Escape: the way out of a field that has taken the keyboard. The window
    /// answers by putting focus back on the list.
    callback dismissed();

    width: 186px;
    height: 26px;
    border-radius: Theme.radius;
    // Filled, where the fields in the settings cards are outlined — and that is
    // the rule rather than an exception to it. A stroke says "a control sits on
    // this surface", which a card needs and chrome does not: this one lives in
    // the toolbar among icon buttons that draw no edge at all, and an outline
    // here makes the search box the one bordered thing in a bar of borderless
    // ones.
    background: input.has-focus ? Theme.surface-hi : Theme.hover;

    // The `TextInput` inside announces itself as a text field, but not what
    // the field is for — the placeholder is drawn, not spoken.
    accessible-role: text-input;
    accessible-label: @tr("Filter the list by name");
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder;
    animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

    public function take-focus() {
        input.focus();
        input.select-all();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 3px;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            Icon {
                glyph: Lucide.search;
                tint: input.has-focus ? Theme.accent : Theme.text-dim;
                size: 13px;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            // Drawn under the input rather than by it: Slint's TextInput has no
            // placeholder of its own, and an empty field with no hint is a box
            // that does not say what it does.
            if root.text == "": Text {
                x: 0;
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Theme.idle;
                font-size: Theme.fs-body;
                font-family: Theme.font;
                vertical-alignment: center;
            }
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-family: Theme.font;
                vertical-alignment: center;
                single-line: true;
                edited => { root.edited(self.text); }
                // Escape clears as well as leaves: "get me out of here" and
                // "and put the list back" are the same thought. `rejected`
                // belongs to the LineEdit widget, not to this element, so the
                // key is read directly.
                key-pressed(e) => {
                    if (e.text == Key.Escape) {
                        root.text = "";
                        root.edited("");
                        root.dismissed();
                        return accept;
                    }
                    return reject;
                }
            }
        }

        if root.text != "": VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Lucide.x;
                label: @tr("Clear the filter");
                diameter: 20px;
                clicked => {
                    root.text = "";
                    root.edited("");
                }
            }
        }
    }
}

/// Sixty seconds of session throughput — download over upload.
///
/// Shape, not scale. The rates are printed beside it, and what a line adds is
/// the one thing a number cannot say: whether this is going anywhere. There is
/// no axis for the same reason — a footer has no room to label one, and the
/// question it answers is "steady, climbing or dying", not "how much".
///
/// The two lines share one vertical scale, so upload can be read against
/// download by eye. Empty commands draw nothing, which is what an idle minute
/// is supposed to look like.
export component Sparkline inherits Rectangle {
    /// SVG path commands, built in Rust. The viewbox below mirrors
    /// `zerem_core::history` — the width is one unit per gap between samples.
    in property <string> down;
    in property <string> up;
    width: 104px;
    height: 16px;

    // Upload first, so the download line is the one on top where the two
    // cross. It is the number people are watching.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 59;
        viewbox-height: 100;
        fit: fill;
        commands: root.up;
        stroke: Theme.seeding;
        stroke-width: 1.5px;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 59;
        viewbox-height: 100;
        fit: fill;
        commands: root.down;
        stroke: Theme.accent;
        stroke-width: 1.5px;
    }
}

/// One state in the rail: what it is, and how many are in it.
///
/// The count is the reason the rail is worth its width — it answers "is
/// anything stuck?" without a click, which a row of chips at the top could not
/// do without stealing the room the names need.
export component RailItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <string> count;
    in property <bool> active;
    in property <brush> tint: Theme.text-dim;
    callback chosen();

    height: 34px;
    border-radius: Theme.radius;
    background: active ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

    accessible-role: list-item;
    accessible-label: root.label;
    accessible-item-selected: root.active;
    accessible-action-default => { root.chosen(); }

    // The bar beside the chosen one, which is how Windows 11 says "here" in
    // every navigation pane it has. It grows rather than appearing: the pill
    // behind it says *what* is selected, and this says it arrived.
    Rectangle {
        x: 0;
        width: 3px;
        height: root.active ? 16px : 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 1.5px;
        background: Theme.accent-fill;
        animate height { duration: Theme.quick; easing: Theme.ease-emphasized(); }
    }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 9px;
        spacing: 9px;

        VerticalLayout {
            alignment: center;
            Icon { glyph: root.glyph; tint: root.active ? Theme.accent : root.tint; size: 14px; }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.text;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.count;
            color: Theme.text-dim;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
}

/// A settings row whose value is typed rather than stepped through.
///
/// The presets it replaces were faster to change and impossible to get wrong,
/// and that was the whole argument for them — but it only holds while every
/// number somebody wants is on the list. A limit is not that kind of number:
/// people have a line speed, and they want a figure that relates to it.
///
/// Committed on Enter or on leaving the field, never per keystroke. Typing
/// "500" one character at a time would apply 5, then 50, then 500, and the
/// first two of those are a connection throttled to nothing for a moment.
export component NumberBox inherits HorizontalLayout {
    in property <string> label;
    in property <string> unit;
    in property <string> placeholder;
    in-out property <string> value;
    callback committed(string);
    spacing: 8px;
    alignment: end;

    VerticalLayout {
        alignment: center;

        Rectangle {
            // A button with an icon and a short label comes to about this, and
            // a settings card is a column of both — a field noticeably narrower
            // than the buttons above and below it reads as a different kind of
            // thing rather than the same thing holding a number.
            width: 104px;
            height: 32px;
            border-radius: Theme.radius;
            background: input.has-focus ? Theme.hover : transparent;
            border-width: 1px;
            border-color: input.has-focus ? Theme.stroke-lit : Theme.stroke;
            animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

            accessible-role: text-input;
            accessible-label: root.label;
            accessible-value: root.value;
            accessible-placeholder-text: root.placeholder;

            HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                input := TextInput {
                    text <=> root.value;
                    color: Theme.text;
                    font-size: Theme.fs-body;
                    font-family: Theme.font;
                    vertical-alignment: center;
                    single-line: true;
                    // Digits only. Refusing the keystroke beats accepting it
                    // and explaining afterwards.
                    input-type: number;
                    accepted => { root.committed(self.text); }
                    changed has-focus => {
                        if (!self.has-focus) { root.committed(self.text); }
                    }
                }
            }

            if root.value == "" && !input.has-focus: Text {
                x: 9px;
                text: root.placeholder;
                color: Theme.idle;
                font-size: Theme.fs-body;
                font-family: Theme.font;
                vertical-alignment: center;
                height: parent.height;
            }
        }
    }

    // Only when there is one. It was a fixed 32px slot, on the reasoning that
    // the boxes of a card would then line up whether or not their row carried a
    // unit — and a card where every box has a unit lines up anyway, while a row
    // without one ended up with an empty column holding its field 32px short of
    // the right edge that every button and switch beside it reached.
    if root.unit != "": VerticalLayout {
        alignment: center;
        Text {
            text: root.unit;
            color: Theme.text-dim;
            font-size: Theme.fs-label;
            font-family: Theme.font;
        }
    }
}

/// A switch, for a setting that is on or off.
///
/// A tick box asks "is this ticked?" and a switch says "this is on", which is
/// the question a preference actually answers. The list of files in the add
/// dialog keeps its tick boxes for the same reason: those are a selection, and
/// a selection is exactly what a tick box is for.
///
/// Fluent's proportions: a 40×20 track, outlined and empty when off, filled
/// with the accent when on, and a thumb that grows a little as it crosses.
export component Toggle inherits Rectangle {
    in-out property <bool> on;
    /// What is being switched. Taken from the row's title, because a switch on
    /// its own announces nothing.
    in property <string> hint;
    callback toggled(bool);

    width: 40px;
    height: 20px;
    border-radius: 10px;
    background: root.on ? Theme.accent-fill : transparent;
    border-width: 1px;
    border-color: root.on ? transparent : Theme.text-dim;
    animate background, border-color { duration: Theme.quick; easing: Theme.ease-standard(); }

    accessible-role: switch;
    accessible-label: root.hint;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.flip(); }

    function flip() {
        root.on = !root.on;
        root.toggled(root.on);
    }

    Rectangle {
        width: root.on ? 14px : 12px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.on ? Theme.on-accent : Theme.text-dim;
        x: root.on ? parent.width - self.width - 3px : 4px;
        y: (parent.height - self.height) / 2;
        animate x, width, background { duration: Theme.quick; easing: Theme.ease-standard(); }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.flip(); }
    }
}

/// A closed list of choices, opened on click.
///
/// For a set too long to lay out side by side and too short to search. The
/// language list is the case that asked for it: stepping through it with a
/// button meant clicking twice to get back to what you had.
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in property <string> hint;
    in-out property <int> current;
    callback changed(int);

    width: 190px;
    height: 32px;
    border-radius: Theme.radius;
    background: ta.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: Theme.stroke;
    animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

    accessible-role: combobox;
    accessible-label: root.hint;
    accessible-value: root.options[root.current];

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.options[root.current];
                color: Theme.text;
                font-size: Theme.fs-body;
                font-family: Theme.font;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon { glyph: Lucide.chevron-down; size: 14px; }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { pop.show(); }
    }

    pop := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        Flyout {
            VerticalLayout {
                // Two at the ends rather than four, because each row insets its
                // own highlight by another two: what should be even is the gap
                // between a highlight and the card, not between the row boxes,
                // which are invisible.
                padding: 4px;
                padding-top: 2px;
                padding-bottom: 2px;

                // Nine rows, and then it scrolls. This list was three entries
                // long when the component was written and is twelve now; drawn
                // whole it stands taller than a window somebody has resized
                // down, and a popup cannot grow past the window it sits in — so
                // the entries below the fold would not be reachable at all,
                // which for a language picker means the language you came for.
                ListView {
                    height: min(root.options.length * 34px, 306px);
                    for name[i] in root.options: Rectangle {
                        height: 34px;

                        // The highlight is inset from the row, not the row spaced
                        // from its neighbour. Two rounded shapes that touch read as
                        // one shape with a pinch in it the moment the cursor
                        // crosses between them, and spacing the rows apart instead
                        // would push a list of ten languages past the window.
                        // The same inset pill the file list draws, for the same
                        // reason.
                        Rectangle {
                            y: 2px;
                            height: parent.height - 4px;
                            border-radius: Theme.radius;
                            background: i == root.current ? Theme.selected : (item.has-hover ? Theme.hover : transparent);
                            animate background { duration: Theme.quick; easing: Theme.ease-standard(); }
                        }

                        accessible-role: list-item;
                        accessible-label: name;
                        accessible-item-selected: i == root.current;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: name;
                                color: i == root.current ? Theme.accent : Theme.text;
                                font-size: Theme.fs-body;
                                font-family: Theme.font;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        item := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.current = i;
                                root.changed(i);
                                pop.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

/// A heading above a card. Groups are what keep ten rows from reading as a
/// list of ten unrelated things.
export component SettingsGroup inherits Text {
    color: Theme.text-dim;
    font-size: Theme.fs-label;
    font-family: Theme.font;
    font-weight: Theme.semibold;
}

/// The little box that says what a control is.
///
/// Drawn by the window and positioned from what asked for it, because a
/// control cannot paint outside itself here — see [`Hint`].
///
/// It clamps rather than centring blindly: a tooltip on the last button in a
/// toolbar would otherwise hang past the right edge, and half a word is worse
/// than no word.
export component Tooltip inherits Rectangle {
    background: transparent;

    Rectangle {
        x: min(max(4px, Hint.at-x - self.width / 2), parent.width - self.width - 4px);
        y: min(Hint.at-y, parent.height - self.height - 4px);
        width: caption.width + 16px;
        height: caption.height + 10px;
        border-radius: 6px;
        background: Theme.surface-hi;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000059;

        caption := Text {
            text: Hint.text;
            color: Theme.text;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

/// One card in a row of them, of which exactly one is chosen.
///
/// For a choice with two or three answers that can each be *shown*: a theme is
/// the case this exists for, where a swatch says more in a glance than the word
/// "Dark" does. A dropdown would hide two of the three behind a click for no
/// gain — the whole set fits on the row.
///
/// The chosen one is said twice, by the accent and by the edge, because one of
/// those is a colour and somebody may not see it.
export component RadioCard inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> chosen;
    callback picked;

    height: 62px;
    horizontal-stretch: 1;
    // The float radius, not the control one. It is a card — a surface with
    // something on it — and it is the size of one; the corner a text field uses
    // looks tight on a shape four times as tall.
    border-radius: Theme.radius-float;
    background: root.chosen ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: root.chosen ? Theme.accent-fill : Theme.stroke;
    animate background, border-color { duration: Theme.quick; easing: Theme.ease-standard(); }

    accessible-role: list-item;
    accessible-label: root.label;
    accessible-item-selected: root.chosen;
    accessible-action-default => { root.picked(); }

    VerticalLayout {
        alignment: center;
        spacing: 5px;
        HorizontalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                tint: root.chosen ? Theme.accent : Theme.text-dim;
                size: 18px;
            }
        }
        Text {
            text: root.label;
            color: root.chosen ? Theme.accent : Theme.text;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            font-weight: root.chosen ? Theme.semibold : 400;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}
