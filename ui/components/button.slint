// Buttons.
//
// **No borders.** An outline on every button is the 2018 look; Material 3 has
// five variants and Outlined is the one you reach for when a control needs to
// separate itself from a busy background, not the default. The defaults here are
// tonal — a filled surface, no stroke — and text for anything tertiary.
//
// Four variants, and the choice is about weight rather than decoration:
//
//   Tonal    the ordinary one. A surface, no outline.
//   Text     tertiary. Nothing until hovered.
//   Primary  the single affirmative action in a dialog. Filled accent.
//   Danger   destructive. Coloured text on a tonal surface, never a red block —
//            a red slab reads as the primary action, which is the opposite of
//            what a destructive button should invite.

import { Theme } from "../theme.slint";
import { Icon } from "icons.slint";
import { Hint } from "../state.slint";
import { Tip } from "tip.slint";

export enum ButtonKind { tonal, text, primary, danger }

export component Button inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <ButtonKind> kind: ButtonKind.tonal;
    in property <bool> enabled: true;
    callback clicked;

    // A `TouchArea` is invisible to a screen reader — it is a rectangle that
    // happens to react. Every control in this app is built out of one, so
    // without these the whole window reads as a picture.
    //
    // The default action is wired too, and not only announced: a reader has to
    // be able to press the button, not just say its name.
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    /// Whether this one speaks in a colour rather than in ink.
    ///
    /// Two do: the recommended action and the destructive one. Everything else
    /// is a neutral outline, and there is no filled button in the app any more
    /// — grok.com has none either, and a single filled control among outlined
    /// ones is the odd shape in the row rather than the important one.
    property <bool> coloured: kind == ButtonKind.primary || kind == ButtonKind.danger;
    /// Which colour, when it is one.
    property <brush> hue: kind == ButtonKind.danger ? Theme.danger : Theme.accent-fill;

    // The colour is in the word and the mark, and nowhere else.
    //
    // It filled with the colour on hover for a while, which meant the button
    // changed shape under the cursor and the word had to invert to survive it.
    // Two states doing the work of one: what a colour on a label is for is
    // saying which button this is, and it says that just as well standing
    // still.
    property <brush> ink: !enabled ? Theme.idle : root.coloured ? root.hue : Theme.text;

    height: 32px;
    width: row.preferred-width + 26px;
    border-radius: 16px;
    // Neutral, except under the cursor on the destructive one — where the wash
    // is a pale version of the colour already in the word rather than a fill
    // that replaces it. It is the one place in this app where pointing at
    // something asks "are you sure" before the click does.
    background: !enabled ? transparent
        : kind == ButtonKind.danger && ta.pressed ? Theme.danger.with-alpha(0.22)
        : kind == ButtonKind.danger && ta.has-hover ? Theme.danger.with-alpha(0.12)
        : ta.pressed ? Theme.pressed
        : ta.has-hover ? Theme.hover
        : transparent;

    /// Whether it wears an edge.
    ///
    /// Follows the kind, and can be told otherwise. `ButtonKind` conflates two
    /// things — how heavy a button is and what colour it carries — and the
    /// detail panel wants the second without the first: a Remove that is red
    /// but sits as quietly as the text buttons beside it. In a dialog the same
    /// red button is the destructive answer to a question and keeps its edge.
    in property <bool> outlined: root.kind != ButtonKind.text;

    // Not on a text button, which is a word and nothing else.
    border-width: !enabled || !root.outlined ? 0px : 1px;
    border-color: Theme.stroke;
    animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;

        if root.glyph != "": VerticalLayout {
            alignment: center;
            Icon { glyph: root.glyph; tint: root.ink; size: 15px; }
        }
        if root.label != "": Text {
            text: root.label;
            color: root.ink;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            // Every button, not only the coloured ones.
            //
            // M3 sets a button's label in Label Large, which is Medium — 500 —
            // and the reason is that a button is a *target*: the word is the
            // thing being aimed at, and at 400 it read as a caption that
            // happened to sit inside a shape. The weight is what makes it look
            // pressable before the cursor arrives.
            //
            // 550 rather than 500 because this app ships two weights and that
            // is one of them, and the difference between them is smaller than
            // the difference between either and 400. A third cut for fifty
            // units is a token nobody could tell from its neighbour.
            font-weight: Theme.semibold;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// A square button that is only an icon. Same surface rules, round.
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <brush> tint: Theme.text-dim;
    /// Passed through to the mark, for the one glyph with a filled part in it.
    /// See `Icon::ink`.
    in property <brush> ink: transparent;
    // Google's proportions, which are the ones asked for: a round target of
    // about forty pixels with a twenty-pixel glyph in it. It was 26 and 15 —
    // near half — which is a size that reads as a decoration beside the text
    // buttons next to it rather than as something to press.
    in property <length> diameter: 36px;
    /// What it is, in words. An icon-only control has no text to fall back on,
    /// so this is the only thing a reader can announce — a button without one
    /// is announced as "button" and nothing else.
    in property <string> label;
    /// What to teach, on screen, for an icon that does not explain itself.
    ///
    /// Separate from `label`, and that separation is the fix: every icon button
    /// needs a label, because a screen reader has nothing else — and showing
    /// every label meant a caption over the close button of a dialog, every
    /// time the pointer crossed it. A tooltip is for the mark somebody has to
    /// learn; a cross is not one.
    ///
    /// Empty by default, so a button says nothing on screen until it has a
    /// reason to.
    in property <string> tip;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    width: diameter;
    height: diameter;
    border-radius: diameter / 2;
    background: ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

    Icon {
        glyph: root.glyph;
        tint: root.tint;
        ink: root.ink;
        size: root.diameter * 0.56;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // The waiting, the anchoring and the taking-down all live in here now. The
    // rail needs the same behaviour and this file cannot reach it there, so it
    // moved out rather than being written twice.
    tip := Tip {
        text: root.tip;
        over: ta.has-hover;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            tip.dismiss();
            root.clicked();
        }
    }
}
