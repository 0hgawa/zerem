// Buttons.
//
// **No borders.** An outline on every button is the 2018 look; Material 3 has
// five variants and Outlined is the one you reach for when a control needs to
// separate itself from a busy background, not the default. The defaults here are
// tonal — a filled surface, no stroke — and text for anything tertiary.
//
// Four variants, and the choice is about weight rather than decoration:
//
//   Tonal    the ordinary one. A surface, no outline.
//   Text     tertiary. Nothing until hovered.
//   Primary  the single affirmative action in a dialog. Filled accent.
//   Danger   destructive. Coloured text on a tonal surface, never a red block —
//            a red slab reads as the primary action, which is the opposite of
//            what a destructive button should invite.

import { Theme } from "../theme.slint";
import { Icon } from "icons.slint";
import { Hint } from "../state.slint";

export enum ButtonKind { tonal, text, primary, danger }

export component Button inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <ButtonKind> kind: ButtonKind.tonal;
    in property <bool> enabled: true;
    callback clicked;

    // A `TouchArea` is invisible to a screen reader — it is a rectangle that
    // happens to react. Every control in this app is built out of one, so
    // without these the whole window reads as a picture.
    //
    // The default action is wired too, and not only announced: a reader has to
    // be able to press the button, not just say its name.
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    property <bool> filled: kind == ButtonKind.primary;
    property <bool> aimed: ta.has-hover || ta.pressed;
    // Red only once it is pointed at. It was red always, which contradicts the
    // rule the table already follows for the same verb: a permanently red
    // control in something opened constantly is a standing warning, and a
    // warning that is always on is one nobody reads. Quiet until aimed at,
    // unmistakable the moment it is.
    property <brush> ink: !enabled ? Theme.idle
        : kind == ButtonKind.primary ? Theme.on-accent
        : kind == ButtonKind.danger && root.aimed ? Theme.danger
        : Theme.text;

    height: 32px;
    width: row.preferred-width + 26px;
    border-radius: 16px;
    // Outlined, to be looked at. The filled version is committed either side of
    // this one, so switching back is a revert.
    background: !enabled ? transparent
        : filled ? (ta.pressed ? Theme.accent-fill.darker(15%) : Theme.accent-fill)
        // The wash follows the ink: the one place in this app where hovering
        // says "are you sure" before the click does.
        : kind == ButtonKind.danger && root.aimed ? Theme.danger.with-alpha(ta.pressed ? 0.24 : 0.14)
        : ta.pressed ? Theme.selected
        : ta.has-hover ? Theme.hover
        : transparent;

    // Not on the filled one, which has its own edge, and not on a text button,
    // which is a word and nothing else.
    border-width: !enabled || filled || kind == ButtonKind.text ? 0px : 1px;
    border-color: kind == ButtonKind.danger && root.aimed ? Theme.danger.with-alpha(0.55) : Theme.stroke;
    animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;

        if root.glyph != "": VerticalLayout {
            alignment: center;
            Icon { glyph: root.glyph; tint: root.ink; size: 15px; }
        }
        if root.label != "": Text {
            text: root.label;
            color: root.ink;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            font-weight: root.filled ? 600 : 400;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// A square button that is only an icon. Same surface rules, round.
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <brush> tint: Theme.text-dim;
    // Google's proportions, which are the ones asked for: a round target of
    // about forty pixels with a twenty-pixel glyph in it. It was 26 and 15 —
    // near half — which is a size that reads as a decoration beside the text
    // buttons next to it rather than as something to press.
    in property <length> diameter: 36px;
    /// What it is, in words. An icon-only control has no text to fall back on,
    /// so this is the only thing a reader can announce — a button without one
    /// is announced as "button" and nothing else.
    in property <string> label;
    callback clicked;

    /// The label, on screen, after a pause.
    ///
    /// It was written for screen readers and nothing else could reach it, which
    /// meant five icons in a toolbar and no way to learn any of them. The first
    /// question anybody asked about this toolbar was what one of the buttons
    /// did — that is the question a tooltip exists to answer.
    ///
    /// The button asks for it rather than drawing it. Drawing it here meant a
    /// rectangle painted *below the button and outside it*, and this app
    /// renders in software with partial redraw: the dirty region is worked out
    /// from an element's own geometry, so a child painting outside its parent
    /// leaves its pixels behind and takes a bite out of whatever was under
    /// them. Parts of the window went missing, and this was why.
    ///
    /// So the window draws it, at the top of everything, like every other
    /// floating thing here already is.
    property <bool> settled;
    /// What this button last put on screen.
    ///
    /// Not `label`, and that is the bug this exists for: the slow-limits
    /// button says one thing when the limits are full and another when they
    /// are not, so clicking it while its tooltip was up changed `label` under
    /// the comparison below — the tooltip stopped being recognised as this
    /// button's and stayed on screen for the rest of the session.
    property <string> published;
    wait := Timer {
        // Six hundred was too long to be discovered. Windows waits about four,
        // and a tooltip nobody stays still for is a tooltip nobody has read —
        // the turtle in this toolbar got asked about twice.
        interval: 350ms;
        running: false;
        triggered => {
            root.settled = true;
            self.running = false;
            if (root.label != "") {
                root.published = root.label;
                Hint.text = root.label;
                Hint.at-x = root.absolute-position.x + root.width / 2;
                Hint.at-y = root.absolute-position.y + root.height + 5px;
            }
        }
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    width: diameter;
    height: diameter;
    border-radius: diameter / 2;
    background: ta.pressed ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; easing: Theme.ease-standard(); }

    Icon {
        glyph: root.glyph;
        tint: root.tint;
        size: root.diameter * 0.56;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            // A click is a decision, so the label explaining the choice has
            // done its job. It also stops a button whose words change on
            // click from leaving the old ones on screen.
            if (Hint.text == root.published) {
                Hint.text = "";
            }
            root.settled = false;
            wait.running = false;
            root.clicked();
        }
        changed has-hover => {
            if (self.has-hover) {
                wait.running = true;
            } else {
                wait.running = false;
                root.settled = false;
                // Only if it is still mine. Moving from one button to the next
                // fires this after the other one has already asked, and
                // clearing then would take the new tooltip down with the old.
                if (Hint.text == root.published) {
                    Hint.text = "";
                }
            }
        }
    }
}
