// The table: header, rows, cells.
//
// `fg` rather than `color` and `data` rather than `row`, because every element
// already carries a deprecated `color` and GridLayout owns `row`/`col` —
// shadowing either is a compile error.

import { Theme } from "../theme.slint";
import { DetailState, Row, TorrentList } from "../state.slint";
import { Icon, Lucide } from "icons.slint";

export component Cell inherits Rectangle {
    in property <string> text;
    in property <bool> right;
    in property <brush> fg: Theme.text;
    clip: true;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: root.right ? end : start;
        Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.fs-body;
            font-family: Theme.font;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
// The name, led by what the torrent actually holds.
//
// A list of names is read; a list of shapes is scanned — the icon is how a row
// is found before its name is parsed. It stays put while the row is hovered:
// identity belongs on the left and does not move aside for a button.
export component NameCell inherits Rectangle {
    in property <string> text;
    in property <int> content;
    clip: true;
    HorizontalLayout {
        // The room the start/pause button takes at the front of the row.
        padding-left: 34px;
        padding-right: 10px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Icon {
                glyph: Lucide.content-glyph(root.content);
                size: 14px;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.fs-body;
            font-family: Theme.font;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Transferred, total and percentage, over the bar that measures them.
//
// One column where there were two. The bar is drawn only while there is
// something left to do: most of a long-lived list is complete, and a full-width
// wash on every finished row is decoration, not information.
export component ProgressCell inherits Rectangle {
    in property <float> progress;
    in property <string> text;
    in property <int> kind;
    clip: true;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        Rectangle {
            border-radius: 4px;
            background: root.progress < 1.0 ? Theme.track : transparent;
            if root.progress < 1.0: Rectangle {
                x: 0;
                width: parent.width * root.progress;
                height: parent.height;
                border-radius: parent.border-radius;
                // The same palette, in the same order, as the bar in the
                // detail panel: one torrent seen twice should not be two
                // colours. Downloading is `accent-fill` rather than `accent`
                // -- they are a true blue and a violet-blue, and side by side
                // the difference reads as a second meaning that is not there.
                //
                // A stalled torrent takes the grey, not the warning colour.
                // The warning belongs on the *word* -- it is a diagnosis, and a
                // diagnosis is something to read. Poured across half a row at
                // thirty per cent it stopped being a warning and became a slab
                // of mud: `warn` on a light theme is a dark mustard, chosen so
                // it can be read as text, and no colour picked to be legible at
                // full strength survives being washed out over a bar.
                //
                // Grey says the honest thing anyway. The torrent is still
                // downloading; it simply is not moving, which is what the grey
                // means everywhere else in this window.
                background: root.kind == 4 ? Theme.danger
                    : root.kind == 2 ? Theme.seeding
                    : root.kind == 1 ? Theme.accent-fill
                    : Theme.idle;
                // Sits behind the figures, so it has to stay quiet enough to
                // read through: it is a gauge, not a highlight.
                opacity: 0.3;
            }
            Text {
                text: root.text;
                color: Theme.text;
                font-size: Theme.fs-label;
                font-family: Theme.font;
                vertical-alignment: center;
                horizontal-alignment: center;
                width: 100%;
                overflow: elide;
            }
        }
    }
}
export component TableRow inherits Rectangle {
    in property <Row> data;
    in property <int> index;
    // Read from every area that covers the row: whether Slint hands the hover
    // to the topmost one alone or to all of them, this is true in the same
    // cases — so the buttons can never flicker themselves away by stealing the
    // hover from underneath.
    property <bool> hovered: ta.has-hover || run.has-hover || del.has-hover;
    height: Theme.row-h;

    // One item in a list, announced as one sentence — see `Row.a11y`. The
    // default action is the click, which is also what opens the panel, so a
    // reader gets to the inside of a torrent the same way a mouse does.
    accessible-role: list-item;
    accessible-label: root.data.a11y;
    accessible-item-selected: root.data.selected;
    accessible-action-default => { TorrentList.select(root.index, false, false); }
    // The stripe stays on the row itself. Selection and hover do not: Windows
    // 11 draws those as a rounded shape inset from the edges — File Explorer,
    // the Start menu, every list it ships — and a highlight that runs edge to
    // edge is the single thing that makes a list look like Windows 7.
    background: mod(index, 2) == 1 ? Theme.row-alt : transparent;

    Rectangle {
        x: 4px;
        y: 2px;
        width: parent.width - 8px;
        height: parent.height - 4px;
        border-radius: Theme.radius;
        background: data.selected ? Theme.selected : hovered ? Theme.hover : transparent;
        animate background { duration: Theme.quick; easing: Theme.ease-standard(); }
    }

    // A right-click has to open the menu wherever it lands, and three areas
    // cover parts of this row. Each forwards to here so the row is named once.
    function menu-at(x: length, y: length) {
        TorrentList.open-menu(root.index, x, y);
    }

    // The accent bar beside the chosen row: three pixels, rounded at both ends,
    // half the row's height and centred on it. It is the most recognisable
    // thing Windows 11 draws, and it never shifts the layout — a row does not
    // jump by a pixel when it is picked.
    Rectangle {
        x: 1px;
        width: 3px;
        height: data.selected ? parent.height * 0.5 : 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 1.5px;
        background: Theme.accent-fill;
        animate height { duration: Theme.quick; easing: Theme.ease-emphasized(); }
    }

    HorizontalLayout {
        spacing: 0px;
        NameCell {
            width: TorrentList.col-w[0];
            text: data.name;
            content: data.content;
        }
        if TorrentList.col-visible[1]: ProgressCell {
            width: TorrentList.col-w[1];
            progress: data.progress;
            text: data.progress-text;
            kind: data.kind;
        }
        // A failure puts its own message in this cell instead of the word
        // "Error" — the colour already says something is wrong, so the text is
        // free to say what. A running torrent that is standing still does the
        // same: it says why, in the warning colour rather than the healthy one.
        if TorrentList.col-visible[2]: Cell {
            width: TorrentList.col-w[2];
            text: data.state;
            fg: data.kind == 4 ? Theme.danger
                : data.kind == 5 ? Theme.warn
                : data.kind == 2 ? Theme.seeding
                : data.kind == 1 ? Theme.accent
                : Theme.text-dim;
        }
        if TorrentList.col-visible[3]: Cell { width: TorrentList.col-w[3]; text: data.down; right: true; fg: data.kind == 1 ? Theme.text : Theme.text-dim; }
        if TorrentList.col-visible[4]: Cell { width: TorrentList.col-w[4]; text: data.up; right: true; fg: data.kind == 2 ? Theme.text : Theme.text-dim; }
        if TorrentList.col-visible[5]: Cell { width: TorrentList.col-w[5]; text: data.peers; right: true; fg: Theme.text-dim; }
        if TorrentList.col-visible[6]: Cell { width: TorrentList.col-w[6]; text: data.eta; right: true; fg: Theme.text-dim; }
        if TorrentList.col-visible[7]: Cell { width: TorrentList.col-w[7]; text: data.ratio; right: true; fg: Theme.text-dim; }
    }

    ta := TouchArea {
        // Both buttons, because a right-click on an unselected row has to select
        // it first — a menu that acts on something else than what was clicked is
        // the classic way to delete the wrong thing.
        pointer-event(e) => {
            if (e.kind != PointerEventKind.down) {
                return;
            }
            if (e.button == PointerEventButton.right) {
                root.menu-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                return;
            }
            TorrentList.select(root.index, e.modifiers.control, e.modifiers.shift);
        }
        // The same thing Enter does, and what a double click means everywhere
        // else: show me this. `clicked` fires first, so the row is selected by
        // the time this runs.
        double-clicked => { TorrentList.open-row-folder(root.index); }
    }

    // Start and pause leads, at the very front of the row.
    //
    // It was at the far right, beside Remove, and that was the wrong end. It is
    // the commonest action in the app, and on a wide window the name being read
    // is a thousand pixels away from the button that acts on it. At the front it
    // sits at a fixed x, so a run of rows can be paused without the hand moving
    // sideways at all — and it is where the eye already is, because the eye is
    // on the names.
    //
    // Remove stays at the far right, and that split is the point rather than an
    // inconsistency: what is done constantly goes where the hand is, and what
    // cannot be undone goes as far from it as the row allows. They are no
    // longer neighbours, so the destructive one is never the near miss of the
    // other.
    //
    // Both act on the row under the pointer and leave the selection alone — no
    // selecting first, and no chance of hitting a torrent the cursor is not on.
    // Declared after `ta` so they take their own clicks.
    // The play button stays whatever the panel is doing. It is the verb people
    // use most, on whichever row the cursor happens to be over — which is not
    // necessarily the row the panel is showing.
    run := TouchArea {
        // A `TouchArea` is invisible to a screen reader — it is a rectangle that
        // happens to react. These two are the most-pressed controls in the whole
        // app and they announced nothing, so a reader was handed the row and
        // then found empty space where its buttons are.
        accessible-role: button;
        accessible-label: data.active ? @tr("Pause") : @tr("Start");
        accessible-action-default => {
            if (data.active) {
                TorrentList.pause-row(root.index);
            } else {
                TorrentList.start-row(root.index);
            }
        }
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        mouse-cursor: pointer;
        clicked => {
            if (data.active) {
                TorrentList.pause-row(root.index);
            } else {
                TorrentList.start-row(root.index);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.menu-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        Rectangle {
            border-radius: 7px;
            background: run.pressed ? Theme.pressed
                : run.has-hover ? Theme.surface-hi
                : transparent;
            animate background { duration: Theme.quick; easing: Theme.ease-standard(); }
            Icon {
                glyph: data.active ? Lucide.pause : Lucide.play;
                // Dim until the row is under the cursor. Present, but not
                // twenty black triangles down the side of a full window.
                tint: root.hovered ? Theme.text : Theme.text-dim;
                size: 13px;
            }
        }
    }

    // Remove goes away while the panel is open: the panel has its own, the
    // table is narrower with it out, and two buttons for the one destructive
    // verb is one too many. Play does not — see above.
    del := TouchArea {
        accessible-role: button;
        accessible-label: @tr("Remove");
        accessible-action-default => { TorrentList.remove-row(root.index); }
        visible: !DetailState.open;
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        mouse-cursor: pointer;
        clicked => { TorrentList.remove-row(root.index); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.menu-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        Rectangle {
            border-radius: 7px;
            // Nothing until it is pointed at, which is what the play button
            // beside it does. It used to carry a grey chip on every row at all
            // times — to stay legible over whatever the last column shows —
            // and the result was a column of grey squares down the window,
            // louder than the button it was protecting.
            background: del.pressed ? Theme.pressed
                : del.has-hover ? Theme.surface-hi
                : transparent;
            animate background { duration: Theme.quick; easing: Theme.ease-standard(); }
            Icon {
                // Red only under the cursor. A permanently red icon on every
                // row turns the list into a wall of warnings.
                glyph: Lucide.trash;
                tint: del.has-hover ? Theme.danger : Theme.text-dim;
                size: 12px;
            }
        }
    }
}

export component HeaderCell inherits Rectangle {
    in property <bool> right;
    in property <int> idx;
    property <bool> active: TorrentList.sort-col == idx;
    clip: true;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 3px;
        alignment: root.right ? end : start;
        Text {
            text: TorrentList.col-title[root.idx];
            color: active ? Theme.accent : Theme.text-dim;
            font-size: Theme.fs-label;
            font-family: Theme.font;
            font-weight: Theme.semibold;
            vertical-alignment: center;
            overflow: elide;
        }
        if active: VerticalLayout {
            alignment: center;
            Icon {
                glyph: TorrentList.sort-desc ? Lucide.chevron-down : Lucide.chevron-up;
                tint: Theme.accent;
                size: 13px;
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { TorrentList.sort(root.idx); }
        // The right button opens the column menu instead of sorting. `clicked`
        // is left-only in Slint, so the two never collide.
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                TorrentList.open-columns(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    // Last, so it sits above the sort TouchArea and wins the grip strip.
    TouchArea {
        x: parent.width - 4px;
        width: 8px;
        mouse-cursor: col-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { TorrentList.resize-begin(root.idx); }
        }
        moved => {
            if (self.pressed) { TorrentList.resize-move(root.idx, self.mouse-x - self.pressed-x); }
        }
    }
}

export component TableHeader inherits Rectangle {
    height: Theme.header-h;
    background: Theme.surface;
    HorizontalLayout {
        spacing: 0px;
        HeaderCell { width: TorrentList.col-w[0]; idx: 0; }
        // Named for what it sorts by. The cell shows the progress too, and the
        // bar says so without a word in the header: size is the key worth
        // ordering on, and the only one of the two that does not force a
        // re-sort every tick.
        if TorrentList.col-visible[1]: HeaderCell { width: TorrentList.col-w[1]; idx: 1; }
        if TorrentList.col-visible[2]: HeaderCell { width: TorrentList.col-w[2]; idx: 2; }
        if TorrentList.col-visible[3]: HeaderCell { width: TorrentList.col-w[3]; idx: 3; right: true; }
        if TorrentList.col-visible[4]: HeaderCell { width: TorrentList.col-w[4]; idx: 4; right: true; }
        if TorrentList.col-visible[5]: HeaderCell { width: TorrentList.col-w[5]; idx: 5; right: true; }
        if TorrentList.col-visible[6]: HeaderCell { width: TorrentList.col-w[6]; idx: 6; right: true; }
        if TorrentList.col-visible[7]: HeaderCell { width: TorrentList.col-w[7]; idx: 7; right: true; }
        // The slack past the last column. It takes the right-click too, so the
        // way back from hiding several of them is where the eye already is.
        Rectangle {
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                        TorrentList.open-columns(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
        }
    }
}
