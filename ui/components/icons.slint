// Lucide, as path data.
//
// One family throughout — mixing icon sets is the fastest way to make an
// interface look assembled rather than designed. Lucide is ISC-licensed, drawn
// on a 24×24 grid with a 2-unit stroke, round caps and joins.
//
// Stored as commands rather than fetched at runtime: an icon that arrives over
// the network is an icon that is missing when it matters.
//
// https://lucide.dev — the `d` attributes below are the upstream ones verbatim.

import { Theme } from "../theme.slint";

export global Lucide {
    // Several of these are one string holding several subpaths. SVG path data
    // allows that, but only an **uppercase** `M` makes the join safe. A
    // lowercase `m` is relative to wherever the previous subpath ended, so a
    // shape that is right as its own `<path>` upstream lands somewhere else
    // entirely once it is concatenated here — and silently, because a path
    // outside the viewbox is simply not drawn.
    //
    // Five icons shipped wrong that way, found by looking at the running app:
    // both status-bar arrows were a bare stem with the head off the grid, the
    // sun had no diagonal rays, and the magnifier and the image icon had lost
    // a stroke each. Upstream `d` is still pasted verbatim; the one edit
    // allowed is turning a joining `m x y` into `M x y l`, which is the same
    // shape written absolutely.
    out property <string> play: "M6 3 20 12 6 21Z";
    out property <string> pause: "M15 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M6 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z";
    out property <string> trash: "M10 11v6 M14 11v6 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M3 6h18 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2";
    out property <string> folder-open: "m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2";
    // A gear, which is what a settings button is. It was `sliders`, which is
    // what a settings *panel* full of faders looks like — close enough to seem
    // deliberate and wrong enough to be asked about.
    out property <string> settings: "M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915 M12 9a3 3 0 1 0 0 6 3 3 0 1 0 0-6z";
    out property <string> copy: "M14 8h6a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2z M4 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2";
    out property <string> clipboard: "M9 2h6a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2";
    out property <string> plus: "M5 12h14 M12 5v14";
    // Three of these, because the state rail has three states and one button
    // changes it — so the button has to say which one you are in.
    //
    // The family VS Code uses for the same control, and for the same reason:
    // the box is the window, and the pane is the narrow part on its left. The
    // divider stays put across all three, so what changes between them is only
    // ever what is *in* the pane. Nothing, dashes, or ink.
    //
    // No accent on any of them. Three drawings say it, and the accent means
    // "selected" everywhere else in this window.

    /// Lucide's `panel-left`. The pane is there and empty: the rail is off.
    out property <string> panel-left: "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M9 3v18";
    /// Lucide's `panel-left-dashed`. A broken divider for the state in between:
    /// the pane is there, and there is less of it.
    out property <string> panel-left-dashed: "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M9 3v2 M9 9v1 M9 14v1 M9 19v2";
    /// The same box with the pane inked in.
    ///
    /// The outline, then the *right* part as a shape of its own. Under even-odd
    /// the right is covered twice and stays empty while the narrow left is
    /// covered once and fills — one path being an outline and a solid block at
    /// the same time. Its own left edge falls exactly where the divider is
    /// drawn in the two above, so the three line up.
    out property <string> panel-left-solid: "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M9 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H9z";
    out property <string> panel-right: "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M15 3v18";
    out property <string> sun: "M12 8a4 4 0 1 0 0 8 4 4 0 1 0 0-8z M12 2v2 M12 20v2 M2 12h2 M20 12h2 M4.93 4.93l1.41 1.41 M17.66 17.66l1.41 1.41 M19.07 4.93l-1.41 1.41 M6.34 17.66l-1.41 1.41";
    out property <string> moon: "M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z";
    out property <string> x: "M18 6 6 18 M6 6l12 12";
    out property <string> check: "M20 6 9 17l-5-5";
    out property <string> chevron-up: "m18 15-6-6-6 6";
    out property <string> chevron-right: "m9 18 6-6-6-6";
    out property <string> chevron-down: "m6 9 6 6 6-6";
    out property <string> arrow-down: "M12 5v14 M19 12l-7 7-7-7";
    out property <string> arrow-up: "M12 19V5 M5 12l7-7 7 7";
    out property <string> file: "M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z M14 2v4a2 2 0 0 0 2 2h4";
    out property <string> users: "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 3a4 4 0 1 0 0 8 4 4 0 1 0 0-8z M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75";
    out property <string> loader: "M12 2v4 M12 18v4 M4.93 4.93l2.83 2.83 M16.24 16.24l2.83 2.83 M2 12h4 M18 12h4 M4.93 19.07l2.83-2.83 M16.24 7.76l2.83-2.83";
    out property <string> search: "M11 3a8 8 0 1 0 0 16 8 8 0 1 0 0-16z M21 21l-4.34-4.34";
    out property <string> arrow-up-to-line: "M5 3h14 M6 13l6-6 6 6 M12 21V7";
    // The update row. Four states, four glyphs: look, fetch, restart, and the
    // way out to a browser when the app cannot install the thing itself.
    out property <string> refresh-cw: "M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5";
    out property <string> download: "M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3";
    out property <string> rotate-cw: "M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8 M21 3v5h-5";
    out property <string> external-link: "M15 3h6v6 M10 14 21 3 M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6";
    out property <string> zap: "M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z";
    // The slow-speed limits.
    //
    // A lightning bolt was here first, which says *fast* — the exact opposite
    // of what the button does. Then a turtle, which is what qBittorrent and
    // uTorrent have used for twenty years and which at fifteen pixels is a
    // blob: it was asked about twice.
    //
    // A dial reads at that size, and it can say which end of itself it means.
    // This is Lucide's `gauge` with the needle mirrored — upstream draws it at
    // the fast end, `m12 14 4-4`, and here it points at the slow one.
    out property <string> gauge-low: "m12 14-4-4 M3.34 19a10 10 0 1 1 17.32 0";
    out property <string> monitor: "M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M8 21h8 M12 17v4";
    out property <string> info: "M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20z M12 16v-4 M12 8h.01";
    out property <string> globe: "M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20";
    out property <string> triangle-alert: "m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3 M12 9v4 M12 17h.01";

    // --- what a torrent holds ---
    //
    // Upstream draws several of these with <rect> and <circle> elements, which
    // `commands` cannot take. They are written out as the equivalent arcs and
    // corner curves — the same conversion `sun`, `users` and `pause` above
    // already carry, so the family still matches itself.
    out property <string> film: "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M7 3v18 M3 7.5h4 M3 12h18 M3 16.5h4 M17 3v18 M17 7.5h4 M17 16.5h4";
    out property <string> music: "M9 18V5l12-2v13 M6 15a3 3 0 1 0 0 6 3 3 0 1 0 0-6z M18 13a3 3 0 1 0 0 6 3 3 0 1 0 0-6z";
    out property <string> image: "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M9 7a2 2 0 1 0 0 4 2 2 0 1 0 0-4z M21 15l-3.086-3.086a2 2 0 0 0-2.828 0L6 21";
    out property <string> file-archive: "M13.659 22H18a2 2 0 0 0 2-2V8a2.4 2.4 0 0 0-.706-1.706l-3.588-3.588A2.4 2.4 0 0 0 14 2H6a2 2 0 0 0-2 2v11.5 M14 2v5a1 1 0 0 0 1 1h5 M8 12v-1 M8 18v-2 M8 7V6 M8 18a2 2 0 1 0 0 4 2 2 0 1 0 0-4z";
    out property <string> disc: "M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20z M12 10a2 2 0 1 0 0 4 2 2 0 1 0 0-4z";
    out property <string> file-text: "M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z M14 2v5a1 1 0 0 0 1 1h5 M10 9H8 M16 13H8 M16 17H8";
    out property <string> files: "M15 2h-4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V8 M16.706 2.706A2.4 2.4 0 0 0 15 2v5a1 1 0 0 0 1 1h5a2.4 2.4 0 0 0-.706-1.706z M5 7a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h8a2 2 0 0 0 1.732-1";

    /// The icon for a `Content` kind.
    ///
    /// The numbers are `Content::kind()` in the order that enum declares its
    /// variants — a contract the core has a test for. `0` is metadata that has
    /// not arrived yet, which gets the neutral file rather than a guess.
    public pure function content-glyph(kind: int) -> string {
        return kind == 1 ? film
            : kind == 2 ? music
            : kind == 3 ? image
            : kind == 4 ? file-archive
            : kind == 5 ? disc
            : kind == 6 ? file-text
            : kind == 7 ? files
            : file;
    }
}

/// One icon.
///
/// The stroke is derived from the size rather than fixed: Lucide draws on a 24
/// grid with a 2-unit stroke, and Slint applies `stroke-width` in screen pixels
/// after the viewbox is scaled — so a literal 2px would come out half again too
/// heavy at 16px. `size / 12` is that same 2-in-24 ratio.
export component Icon inherits Rectangle {
    in property <string> glyph;
    in property <brush> tint: Theme.text-dim;
    in property <length> size: 15px;
    /// How heavy the line is, as a fraction of the size.
    ///
    /// Lucide is drawn with a 2-unit stroke on a 24 grid, which is a twelfth —
    /// the default here, and right for an icon standing on its own. A mark
    /// inside a 16px box is not standing on its own: at that size a twelfth is
    /// a hairline, and a tick has to read as a tick from across the row.
    in property <float> weight: 1.0 / 12.0;
    /// What to pour into the closed parts of the glyph.
    ///
    /// Transparent by default, because Lucide is a stroked family and filling
    /// it turns every open shape into a blob. One mark wants it: the rail's
    /// button, whose open state is a panel with something in it — the same
    /// icon VS Code uses for the same control, and the only way to say "there
    /// is a pane there" without a second colour.
    ///
    /// The rule is even-odd, so a glyph fills the region its subpaths enclose
    /// an odd number of times. That is what lets one path be an outline *and* a
    /// filled part of itself.
    in property <brush> ink: transparent;

    width: size;
    height: size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.glyph;
        stroke: root.tint;
        stroke-width: root.size * root.weight;
        // Round, because that is how the family is drawn — the note at the top
        // of this file says so and the element was defaulting to butt and
        // mitre regardless. It also decides whether a dot renders at all: the
        // warning triangle's full stop is a segment one hundredth of a unit
        // long, which is a round cap or it is nothing.
        stroke-line-cap: round;
        stroke-line-join: round;
        // Lucide is a stroked family, so this is transparent unless a glyph
        // asks otherwise — filling an open shape turns it into a blob.
        fill: root.ink;
        fill-rule: evenodd;
    }
}
