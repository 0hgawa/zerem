// Shared UI state, kept out of the window composition so any panel can read and
// write it without threading dozens of properties through component interfaces.
//
// Split by domain from the start. Vayou's single `PlayerState` reached ~90
// properties and stopped saying who owns what; here each surface gets its own
// global and joins when it has something to hold. Two exist today because two
// carry data — `DetailState` and `Prefs` arrive with the panels that need them,
// not before.

/// One formatted row. Every field is a finished string: Rust builds this only
/// for rows that actually changed, and the `.slint` never formats anything.
export struct Row {
    id: int,
    name: string,
    // What the torrent mostly holds — mirrors Content::kind(), and the number
    // Lucide.content-glyph() turns into an icon.
    content: int,
    progress: float,
    // "491 MB / 1.92 GB · 26%", or just the size once it is complete. One
    // string where there used to be a Size column and a percentage.
    progress-text: string,
    state: string,
    // 0 paused · 1 downloading · 2 seeding · 3 checking · 4 error · 5 stalled
    // — mirrors TorrentRow::status-kind(), which is State::kind() until a
    // running torrent stops moving and the row has to stop looking healthy.
    kind: int,
    // Whether it is transferring, which is what the hover action offers to
    // change. Carried rather than derived from `kind` here, because deciding it
    // is domain logic and the .slint decides nothing.
    active: bool,
    down: string,
    up: string,
    peers: string,
    eta: string,
    ratio: string,
    selected: bool,
    // One sentence for a screen reader, built in Rust like every other string
    // here. A row is eight cells of numbers; read out cell by cell it is a
    // list of figures with no subject, so it is composed once instead.
    a11y: string,
}

// Strings, not numbers: Rust does every conversion, here as everywhere. A count
// interpolated in the UI would be one more place formatting could drift from
// the rest of the app.
export struct FileEntry {
    /// Whether this is something a player would open. Decided in Rust from the
    /// extension — the window formats nothing and knows nothing about
    /// containers.
    playable: bool,
    /// The whole relative path, which is what a screen reader is told and what
    /// the file is opened by. What is *drawn* is the two halves below.
    path: string,
    /// Where it lives, already carrying its separators, and empty for a file
    /// at the top of the torrent. Dim, because it is not what anyone is
    /// looking for — the name is.
    folder: string,
    /// What it is called.
    name: string,
    /// The icon the desktop itself shows for this kind of file, so a `.mkv`
    /// here carries the same picture it carries in Explorer. Empty on a
    /// platform that has no such notion, and the line falls back to a glyph.
    icon: image,
    size: string,
    pct: string,
    progress: float,
    complete: bool,
    /// Whether this file is being fetched before the others. While any file in
    /// a torrent is pinned it is the only one coming down — the summary line
    /// above the list says so, because it is not a small thing to leave unsaid.
    first: bool,
    /// Whether it is being fetched at all. A torrent added without a choice
    /// wants everything, so this is normally true on every line.
    wanted: bool,
}

export struct PeerEntry {
    addr: string,
    /// Whose address this is. Empty for one nobody has been delegated, which
    /// draws nothing rather than a placeholder.
    flag: image,
    client: string,
    transport: string,
    state: string,
    down: string,
    up: string,
}

/// One shelf in the rail: what it is called and how many are on it.
export struct CategoryEntry {
    name: string,
    count: string,
    active: bool,
}

export struct PendingFileEntry {
    path: string,
    size: string,
    wanted: bool,
}

/// The add dialog: what is in the torrent, and where it will go.
///
/// Adding is two steps — inspect, then confirm — because the two decisions that
/// matter are made here, and every client buries them in a cramped modal.
export global AddState {
    in-out property <bool> open;
    in-out property <string> name;
    in-out property <[PendingFileEntry]> files;
    /// "3 of 12 files · 1.4 GB of 3.7 GB", built in Rust like every other
    /// number in this app.
    in-out property <string> summary;
    in-out property <string> destination;
    /// The folder the files go in, which starts as the torrent's own name and
    /// can be typed over. Only the folder: librqbit takes the file names from
    /// the metadata, so the dialog does not pretend the files can be renamed.
    in-out property <string> folder;
    /// Whether there is a folder at all — a single-file torrent goes straight
    /// into the destination and has nothing to name.
    in-out property <bool> has-folder;
    /// The shelf this torrent goes on. Typing a name that is already a shelf
    /// moves the destination to that shelf's folder; typing a new one makes it
    /// mean whatever destination is showing.
    in-out property <string> category;
    callback category-typed(string);
    /// "Not enough room in this folder — 2.51 GB short", or empty. A warning
    /// and not a refusal: see the dialog for why the Add button stays live.
    in-out property <string> shortfall;
    /// Waiting on a magnet's metadata to come back from the swarm.
    in-out property <bool> fetching;
    in-out property <string> error;
    in-out property <bool> can-add;

    callback confirm();
    callback cancel();
    callback toggle-file(int);
    callback set-all(bool);
    callback change-destination();
}

/// The inside of one torrent. Empty and idle unless the drawer is open — the
/// engine is not even asked for this until then.
export global DetailState {
    in-out property <bool> open;
    /// How wide the drawer is. Pushed from Rust, which owns the clamp and the
    /// saving — sizing it as a share of the window would read better and is a
    /// binding loop, since the window derives its own width from its children.
    in-out property <length> width: 360px;
    in-out property <string> title;
    in-out property <string> tab: "files";
    in-out property <[FileEntry]> files;
    in-out property <[PeerEntry]> peers;
    in-out property <string> files-summary;
    in-out property <string> peers-summary;
    /// "12 files · 3.72 GB", or "3 of 12 files · 1.44 GB of 3.72 GB" once
    /// something has been left out. Built in Rust like every other number here.
    in-out property <string> files-choice;
    /// Whether anything has been left out — what the header tick draws, and
    /// which way clicking it goes.
    in-out property <bool> files-partial;
    /// The folder the files sit in — the torrent's own name — and what it comes
    /// to. The header row of the list, the way a file manager shows a folder
    /// above what is inside it.
    in-out property <string> files-folder;
    /// The desktop's own folder icon, so the row that stands for the torrent's
    /// folder looks like a folder in the file manager beside it rather than a
    /// drawing of one. Empty on a platform with no such notion.
    in-out property <image> folder-icon;
    /// Why this torrent stopped, when it has. Empty means it has not.
    ///
    /// The state column carries it too, elided into whatever fits; here there
    /// is room to read it and, next to it, the one button that acts on it.
    in-out property <string> fault;

    // --- how the torrent in this panel is doing ---
    //
    // The panel said the name and nothing else: you opened the insides of a
    // torrent and could not tell whether it was moving. All of it comes from
    // the same row the table draws, so the two can never disagree.
    in-out property <float> progress;
    in-out property <string> progress-text;
    in-out property <string> state;
    /// Which colour the state is written in — the table's own `kind`.
    in-out property <int> kind;
    in-out property <bool> running;
    in-out property <string> down;
    in-out property <string> up;
    in-out property <string> eta;
    in-out property <string> ratio;
    in-out property <string> swarm;

    callback close();
    callback pick-tab(string);
    /// Start or stop *this* torrent — the one in the panel, which is not
    /// necessarily the whole selection. Ctrl-clicking three rows and pressing
    /// the panel's button should not act on the other two.
    callback toggle-running();
    callback open-folder();
    callback remove();
    /// Fetch this file, or stop fetching it. Applies to the line at once; the
    /// engine's next snapshot is the truth, and puts the tick back if it said no.
    callback toggle-file(int);
    /// Fetch this file before the others, or stop. Same rule: applied at once,
    /// corrected by the next snapshot if the engine refused.
    callback toggle-first(int);

    // --- the right-click menu on a file ---
    //
    // Which line it was opened on, and where. Held here rather than passed
    // through the menu because the menu is a sibling of the list, not a child:
    // it floats over the whole window so it cannot be clipped by the panel it
    // came from.
    in-out property <bool> file-menu-open;
    in-out property <int> file-menu-index: -1;
    in-out property <length> file-menu-x;
    in-out property <length> file-menu-y;
    callback open-file-menu(int, length, length);
    callback close-file-menu();
    /// Hand the file to whatever the desktop opens it with.
    callback open-file(int);
    /// Show it in the file manager, selected.
    callback reveal-file(int);
    /// Hand it to a media player *now*, finished or not.
    callback play-file(int);
    /// Every file at once, both ways — the tick above the list. Fetching
    /// nothing is allowed and the row says so; it used to be refused, which
    /// made this a control that only worked in one direction.
    callback set-all-files(bool);
    /// Whether the folder is collapsed. Not persisted: it is a way to get a
    /// long list out of the way for a moment, not a preference.
    in-out property <bool> files-collapsed;
    /// Try the torrent again after it failed. Starting an errored torrent is a
    /// real retry rather than a hopeful one: librqbit re-initialises it, hashes
    /// what is on disk and carries on from there.
    callback retry();
    /// Dragging the drawer's left edge. Same shape as the column handles: the
    /// press records where it started, and every pixel of the drag reports its
    /// distance from there rather than an absolute width.
    callback resize-begin();
    callback resize-move(length);
}

// Joins now because there is finally something to hold. Speeds arrive already
// formatted — "Unlimited", "500 kB/s" — because the alternative is the `.slint`
// deciding how a number reads, which is Rust's job everywhere else.
/// The window itself, now that the window draws its own frame.
///
/// Every one of these ends in a call the operating system used to make on the
/// application's behalf, and each is here because removing the title bar
/// removed the thing that made it.
export global Shell {
    /// Whether it is filling the screen. Read by the maximise button to know
    /// which glyph it is, and by the drag band to know it should not move.
    in-out property <bool> maximized;
    callback minimize();
    callback toggle-maximize();
    callback close();
    /// Move the window by this much, from a drag on the header.
    callback move-by(length, length);
    /// Resize by this much, from a drag on an edge. The first argument is a
    /// bitmask of which edges are being pulled: 1 left, 2 right, 4 top,
    /// 8 bottom — so a corner is two of them.
    callback resize-by(int, length, length);
}

/// The app's own mark, for the window to wear.
///
/// The same drawing as the taskbar icon and the `.ico`, from the same function
/// — so the thing in the corner of the window and the thing in the taskbar
/// cannot drift apart, which is the usual way an app ends up with two logos.
export global Brand {
    in-out property <image> mark;
}

/// What the window is being asked to explain, and where.
///
/// A global because a tooltip has to be drawn by the *window* rather than by
/// the control it belongs to. This app renders in software with partial
/// redraw, and the dirty region is worked out from an element's own geometry —
/// so a control painting a box below itself, outside its own bounds, leaves
/// those pixels behind and takes a bite out of what was under them. Every
/// floating thing here is drawn at the top level for that reason.
export global Hint {
    /// Empty when there is nothing to explain, which is almost always.
    in-out property <string> text;
    /// The middle of the control, and just under it.
    in-out property <length> at-x;
    in-out property <length> at-y;
}

export global Prefs {

    in-out property <bool> open;
    in-out property <string> download-dir;
    /// Typed, not stepped. Empty means unlimited, which is what the placeholder
    /// says rather than a word somebody has to clear before typing a number.
    in-out property <string> down-limit;
    in-out property <string> up-limit;
    in-out property <string> port;
    in-out property <string> alt-down-limit;
    in-out property <string> alt-up-limit;
    /// Whether the other pair of limits is the one in force.
    in-out property <bool> alt-speed;
    in-out property <bool> add-paused;
    /// Where a finished torrent is moved to. Empty means it stays put.
    in-out property <string> keep-dir;
    /// Where `.torrent` files are picked up from. Empty means nowhere.
    in-out property <string> watch-dir;
    in-out property <bool> utp;
    in-out property <bool> upnp;
    /// Every language on offer: "System" first, then each one named in itself.
    /// Filled once at startup — the set a build ships cannot change while it
    /// runs.
    in-out property <[string]> languages;
    /// Which of them is chosen.
    in-out property <int> language-index;
    /// "No limit", or how many download at once.
    in-out property <string> max-active;

    callback close();
    callback pick-download-dir();
    callback pick-keep-dir();
    callback keep-dir-picked(string);
    /// Stop moving finished torrents anywhere.
    callback clear-keep-dir();
    callback pick-watch-dir();
    callback watch-dir-picked(string);
    callback clear-watch-dir();
    /// Whether the confirmation for putting everything back is up.
    in-out property <bool> resetting;
    /// Which theme was chosen: "system", "light" or "dark". Not the same
    /// question as `Theme.dark`, which is what the window is drawn in *now* —
    /// following the system is a choice that resolves to one of the other two.
    in-out property <string> theme;
    callback pick-theme(string);
    /// What the About section shows: the version and what it is built on.
    /// Filled once at startup — neither changes while the app runs.
    in-out property <string> version;
    in-out property <string> engine;
    /// Put every setting back to what it was on the first launch.
    callback reset-all();
    /// Raised by the picker thread once the user has chosen, not by anything in
    /// the UI. It is how that thread gets back onto this one carrying a value:
    /// invoking a callback is the only handoff Slint offers that arrives with
    /// the handler's own context intact.
    callback download-dir-picked(string);
    /// A number the user finished typing — on Enter, or on leaving the field.
    /// Never per keystroke: "500" typed one character at a time would apply 5,
    /// then 50, and the first two of those throttle a connection to nothing.
    callback set-down-limit(string);
    callback set-up-limit(string);
    callback set-max-active(string);
    callback set-port(string);
    callback set-alt-down-limit(string);
    callback set-alt-up-limit(string);
    /// Switch between the two pairs. On the toolbar as well as here, because
    /// the whole point of it is being one click away at nine in the evening.
    callback toggle-alt-speed();
    callback set-add-paused(bool);
    callback set-utp(bool);
    callback set-upnp(bool);
    /// Chooses a language by its place in `languages`. The swap is live:
    /// Slint's bundled translations are a property, so every string redraws
    /// without a restart.
    callback set-language(int);
}

export global SessionState {
    in-out property <string> down: "—";
    in-out property <string> up: "—";
    in-out property <string> active: "0";
    in-out property <string> paused: "0";
    in-out property <string> total: "0";
    /// "12 of 300" while a filter is on, empty otherwise. It replaces the plain
    /// total rather than joining it: two counts side by side is one too many.
    in-out property <string> matched;
    /// Something the user needs to be told that belongs to no single row — a
    /// magnet that would not parse, a port already taken. Empty means silence.
    in-out property <string> notice;
    /// The last minute of throughput as SVG path commands, drawn in the
    /// footer. Built in Rust, like every other string here: a `for` loop in
    /// the `.slint` would run once per frame instead of once per second.
    /// Empty when there is nothing worth drawing.
    in-out property <string> spark-down;
    in-out property <string> spark-up;
    /// How many torrents are in each state, for the rail. Strings, because
    /// every number in this app is turned into one in Rust.
    in-out property <string> downloading: "0";
    in-out property <string> seeding: "0";
    in-out property <string> queued: "0";
    in-out property <string> failed: "0";
}

export global TorrentList {
    // --- pushed from Rust ---
    in-out property <[Row]> rows;
    in-out property <[length]> col-w: [300px, 200px, 108px, 96px, 96px, 84px, 84px, 66px];
    /// Which columns are drawn. Index 0 — the name — is never turned off.
    in-out property <[bool]> col-visible: [true, true, true, true, true, true, true, true];
    /// The headings, pushed from Rust so the header and the column menu name
    /// the same eight things.
    in-out property <[string]> col-title;
    /// What the filter box holds. The parsed form lives in Rust; this is only
    /// what the field draws. Deliberately not persisted — a filter restored at
    /// launch hides torrents for a reason nobody remembers.
    in-out property <string> filter;
    /// Which state the rail has the view narrowed to — mirrors Shown::index().
    in-out property <int> shown;
    /// Whether the rail is on screen. Persisted, like the drawer.
    in-out property <bool> rail-open: true;
    /// The shelves, with their counts. Built in Rust like every other list.
    in-out property <[CategoryEntry]> categories;
    /// Which shelf the view is on, or empty for all of them.
    in-out property <string> category;
    in-out property <int> sort-col;
    in-out property <bool> sort-desc;
    in-out property <int> selected-count;
    /// Whether every selected torrent is already running, which is what decides
    /// between offering Start and offering Pause.
    in-out property <bool> selection-running;

    // --- the remove confirmation ---
    //
    // Removing is the one destructive thing this app does, so it is the one
    // action that asks first. The dialog owns whether the data goes too; the
    // default is no, because the recoverable choice should be the easy one.
    in-out property <bool> confirming;
    in-out property <string> confirm-what;
    in-out property <bool> confirm-delete-data;

    // --- context menu ---
    in-out property <bool> menu-open;
    in-out property <length> menu-x;
    in-out property <length> menu-y;

    // --- the column menu, on a right-click in the header ---
    in-out property <bool> columns-open;
    in-out property <length> columns-x;
    in-out property <length> columns-y;

    // --- keyboard navigation ---
    //
    // The row the arrows are on. Rust owns it, because moving it is a selection
    // change and selection is held as ids there. The list scrolls to keep it
    // visible; `focus-tick` changes on every move so the scroll fires again even
    // when the row itself did not.
    in-out property <int> focus-row: -1;
    in-out property <int> focus-tick;

    // --- events up ---
    callback sort(int);
    callback resize-begin(int);
    callback resize-move(int, length);
    callback select(int, bool, bool);
    /// Moves the focused row by `delta`, extending the selection when asked.
    callback move-focus(int, bool);
    /// `-1` is the end of the list.
    callback focus-edge(int, bool);
    callback open-menu(int, length, length);
    callback close-menu();
    /// Every keystroke in the filter box. Answered at once, not on the tick.
    callback filter-changed(string);
    /// A click in the rail. Answered at once, not on the tick.
    callback show-state(int);
    /// A click on a shelf. Empty widens back to all of them.
    callback show-category(string);
    /// Whether anything at all is hiding rows — the search box, the state
    /// rail, or a category. The empty state is a different sentence depending
    /// on this, and it used to read only the search box: narrowing to Paused
    /// with nothing paused said "No torrents yet" to somebody with three
    /// hundred of them.
    in-out property <bool> narrowed;
    /// Widen back to everything, however it was narrowed.
    callback show-all();
    callback toggle-rail();
    /// Everything the view is showing — never a row it is hiding, which would
    /// be a delete acting on something nobody could see.
    callback select-all();
    /// A double click on a row: the folder, the same as Enter.
    callback open-row-folder(int);
    callback open-columns(length, length);
    callback close-columns();
    callback toggle-column(int);
    callback open-folder();
    callback copy-magnet();
    /// Check every piece against what is on disk. For a torrent that has gone
    /// wrong, or whose files were deleted or replaced behind the app's back.
    callback recheck-selected();
    callback start-selected();
    callback pause-selected();
    /// Act on the row under the pointer, leaving the selection alone.
    ///
    /// The point of the hover button: no selecting first, and no chance of
    /// hitting a torrent the cursor is not on.
    callback start-row(int);
    callback pause-row(int);
    /// Opens the confirmation. Nothing is removed until `confirm-accept`.
    callback remove-selected();
    /// Remove the row under the pointer, leaving the selection alone. Asks
    /// first, like every other route to removing.
    callback remove-row(int);
    callback confirm-accept();
    callback confirm-cancel();
    callback add-magnet-from-clipboard();
    callback add-torrent-file();
    callback toggle-theme();
    /// Opens or closes the drawer. Closing it also stops the engine building
    /// what it shows.
    callback toggle-details();
}
